+static int pxeos_quiet_shutdown_marker_is_valid(void)
+{
+   struct stat st;
+
+   return lstat("/.pxeos-quiet-shutdown", &st) == 0
+      && S_ISREG(st.st_mode)
+      && st.st_uid == 0
+      && (st.st_mode & 07777) == 0600
+      && st.st_nlink == 1;
+}
+
+static void pxeos_quiet_shutdown_exit(void)
+{
+#ifndef NO_DAEMON
+   if (params->detached!=0) {
+      unlink(params->pid_file);
+   }
+#endif
+   havege_destroy(handle);
+   exit(params->exit_code);
+}
