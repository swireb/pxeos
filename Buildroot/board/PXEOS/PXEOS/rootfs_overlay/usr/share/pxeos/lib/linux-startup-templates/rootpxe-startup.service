[Unit]
Description=RootPXE Linux 开机脚本
RequiresMountsFor=/etc/rootpxe /usr /var/log/rootpxe
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
Restart=no
RuntimeMaxSec=300
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
# 只清除可能改变启动封装行为的危险环境；用户正文另以 env -i 执行。
UnsetEnvironment=BASH_ENV ENV SHELLOPTS BASHOPTS CDPATH GLOBIGNORE LD_PRELOAD LD_LIBRARY_PATH
ExecStart=/bin/bash --noprofile --norc /etc/rootpxe/startup-runner.sh
# 收尾失败应留在 journal，不覆盖真实主进程结果；总期限小于 TimeoutStopSec。
ExecStopPost=-/usr/bin/timeout --signal=TERM --kill-after=1s 8s /bin/bash --noprofile --norc /etc/rootpxe/startup-result.sh

[Install]
WantedBy=multi-user.target
