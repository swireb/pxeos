#!/bin/bash
sysuuid=$(dmidecode -s system-uuid)
sysuuid=${sysuuid,,}
rootpxe_api="${pxeapi:-$web}"
rootpxe_require_task_context || handleError "RootPXE: invalid task context ($0)"

count=0
res=""
if [[ ${type:-} == "up" ]]; then
    rootpxe_stage finalizing "moving captured image into final path"
    rootpxe_finalize_capture || handleError "PXEOS_STAGE=capture_finalize CODE=${rootpxe_finalize_capture_error_code:-CAPTURE_FINALIZE_FAILED} REASON=${rootpxe_finalize_capture_error_reason:-unsafe_finalize_state}"
    if [[ ${imgType:-} == [Nn] ]]; then
        rootpxe_build_original_schema "$hd" "$rootpxe_final_capture_path" || handleError "PXEOS_STAGE=capture_schema CODE=ORIGINAL_SCHEMA_INVALID REASON=capture_facts_or_artifacts_unavailable"
    fi
fi
finish_args=(
    --data-urlencode "taskid=$taskid"
    --data-urlencode "token=$task_token"
    --data-urlencode "mac=$mac"
    --data-urlencode "sysuuid=$sysuuid"
    --data-urlencode "result=success"
    --data-urlencode "message=pxeos imgcomplete type=$type"
)
[[ -n ${capture_size_bytes:-} ]] && finish_args+=(--data-urlencode "sizeBytes=$capture_size_bytes")
[[ -n ${rootpxe_original_schema_file:-} ]] && finish_args+=(--data-urlencode "originalSchema=$(cat "$rootpxe_original_schema_file")")
dots "Notifying RootPXE (finish)"
while true; do
    # 在 bash -e 环境中，临时网络错误不能让命令替换提前终止重试循环。
    if res=$(curl -Lks --connect-timeout 10 --max-time 30 "${finish_args[@]}" "${rootpxe_api}finish" 2>/dev/null); then
        :
    else
        res=""
    fi
    if echo "$res" | grep -q '"success"[[:space:]]*:[[:space:]]*true'; then
        echo "Done"
        if ! rootpxe_clear_capture_marker; then
            rootpxe_console_message WARN "PXEOS_STAGE=finish_notify CODE=CAPTURE_MARKER_CLEAR_FAILED REASON=${rootpxe_capture_marker_clear_error_reason:-marker_clear_failed}"
            rootpxe_console_message WARN 'Marker retained for manual cleanup.'
        fi
        rootpxe_cleanup_task_json
        break
    fi
    if [[ $count -lt 10 ]]; then
        echo "Failed"
        debugPause
        printf " * Error returned: %s" "$res"
        echo
        debugPause
        dots "Reattempting to update database"
    fi
    if [[ $count -ge 10 ]]; then
        echo "Failed"
        debugPause
        printf " * Error returned: %s" "$res"
        echo
        debugPause
        handleError "PXEOS_STAGE=finish_notify CODE=FINISH_RETRY_EXHAUSTED REASON=rootpxe_finish_callback_failed"
    fi
    let count+=1
    usleep $((500000 * (1 << (count > 5 ? 5 : count))))
done
echo " * Task Complete"
debugPause
