#!/bin/bash
# The root disk controller does not statfs the NAS. Every actual create/write
# is checked by the numeric-identity helper and retains failures as evidence.
serverDiskSizeTotal=unknown
serverDiskSizeUsed=unknown
serverDiskSizeUsedPercent=unknown
serverDiskSizeAvailable=unknown
rootpxe_console_message INFO 'Storage capacity is checked during writing.'
debugPause
