#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
. /bin/pxeos.checkin
rootpxe_partition_progress_initialize_runtime
. /bin/pxeos.mount
. /bin/pxeos.checkmount
. /bin/pxeos.checkmountdrivesize
. /bin/pxeos.checkimgvar
rootpxe_require_task_context || handleError "Invalid task context ($0)"
rootpxe_validate_image_contract || handleError "PXEOS_STAGE=capture CODE=IMAGE_CONTRACT_INVALID REASON=unsupported_type_scope_or_partimage_format"
imagePath="/storage/dev/$macWinSafe"
parts=""
part=""
disks=""
disk=""
hd=""
rootpxe_console_message INFO 'Preparing to send image file to server.'
percent="$pct"
[[ $pct -lt 5 || $pct -ge 100 ]] && percent=5
rootpxe_partclone_progress_initialize || handleError "PXEOS_STAGE=capture CODE=CAPTURE_PROGRESS_SETUP_FAILED REASON=unable_to_initialize_partclone_progress"
pxeos.statusreporter "$mac" "${pxeapi:-$web}" "$taskid" "$rootpxe_partclone_progress_run_id" partclone & disown
statusReporter="$!"
if rootpxe_capture_resume_published; then
    imagePath="$rootpxe_final_capture_path"
    rootpxe_console_message INFO 'Capture payload already published; resuming finish notification.'
    . /bin/pxeos.imgcomplete
    exit 0
else
    resume_status=$?
    [[ $resume_status -eq 1 ]] || handleError "PXEOS_STAGE=capture_resume CODE=${rootpxe_capture_resume_error_code:-CAPTURE_PUBLISHED_METADATA_MISSING} REASON=${rootpxe_capture_resume_error_reason:-published_artifacts_retained_for_manual_metadata_confirmation}"
fi
findHDDInfo
rootpxe_capture_disks=()
if [[ ${imgType:-} == mpa ]]; then
    for disk in $disks; do
        [[ $disk =~ mmcblk[0-9]+boot[0-9]+ ]] && continue
        parts=""
        getPartitions "$disk"
        [[ ${#parts} -gt 0 ]] && rootpxe_capture_disks+=("$disk")
    done
    [[ ${#rootpxe_capture_disks[@]} -gt 0 ]] || handleError "PXEOS_STAGE=capture CODE=CAPTURE_SOURCE_EMPTY REASON=no_partitioned_disks"
    rootpxe_capture_disks_string="${rootpxe_capture_disks[*]}"
    export rootpxe_capture_disks_string
fi
# Do not clear staging or probe a writable source filesystem before the
# applicable permit succeeds.  Preserve the established single-disk request
# for n/mps/dd retries; mpa alone requires one atomic binding for every disk.
if [[ ${imgType:-} == mpa ]]; then
    permit_args=()
    for permit_disk in "${rootpxe_capture_disks[@]}"; do
        permit_id=$(rootpxe_disk_stable_identity "$permit_disk") || handleError "PXEOS_STAGE=permit CODE=TARGET_IDENTITY_UNAVAILABLE REASON=unable_to_bind_capture_disk"
        rootpxe_record_disk_permit_binding "$permit_disk" "$permit_id" capture_read_write || handleError "PXEOS_STAGE=permit CODE=TARGET_IDENTITY_UNAVAILABLE REASON=unable_to_record_capture_disk_binding"
        permit_args+=("$permit_id" capture_read_write)
    done
    if rootpxe_wait_for_disk_permit_batch "${permit_args[@]}"; then
        permit_result=0
    else
        permit_result=$?
    fi
else
    capture_target_id=$(rootpxe_disk_stable_identity "$hd") || handleError "PXEOS_STAGE=permit CODE=TARGET_IDENTITY_UNAVAILABLE REASON=unable_to_bind_capture_disk"
    if rootpxe_wait_for_disk_permit "$capture_target_id" capture_read_write; then
        permit_result=0
    else
        permit_result=$?
    fi
    if [[ $permit_result -eq 0 ]]; then
        rootpxe_record_disk_permit_binding "$hd" "$capture_target_id" capture_read_write || handleError "PXEOS_STAGE=permit CODE=TARGET_IDENTITY_UNAVAILABLE REASON=unable_to_record_capture_disk_binding"
    fi
fi
case $permit_result in
    0) ;;
    10) printf '%s\n' reboot > /tmp/pxeos.failure_action; exit 2 ;;
    20) exit 2 ;;
    *) handleError "PXEOS_STAGE=permit CODE=DISK_PERMIT_DENIED REASON=capture_binding_not_confirmed" ;;
esac
# Source mount and drive mappings are display-only facts, but they must be
# sampled before capture can activate/deactivate LVM or otherwise alter source
# visibility.  A failed probe is safe to omit; an unmount failure is not.
if declare -F rootpxe_display_metadata_begin >/dev/null 2>&1; then
    if rootpxe_display_metadata_begin "$hd" "${rootpxe_capture_disks_string:-$hd}" "${imgType:-}"; then
        :
    else
        display_metadata_status=$?
        [[ $display_metadata_status -eq 2 ]] && handleError "PXEOS_STAGE=capture_display_metadata CODE=DISPLAY_METADATA_CLEANUP_FAILED REASON=read_only_probe_cleanup_failed"
        rootpxe_console_message WARN 'Capture display metadata was unavailable; continuing without optional source mappings.'
    fi
fi
prepareUploadLocation "$imagePath"
printf '%s\n' "$taskid" > "$imagePath/.rootpxe-capture-taskid" || handleError "Could not initialize capture task marker ($0)"
rootpxe_console_message INFO "Using image: $img."
# A resizable single-disk image keeps the captured partition layout intact.
# d1.partitions is both the capture fact and the minimum deployment layout;
# administrators may only grow partitions later during deployment.  Capturing
# must therefore never shrink, move, or restore the source disk.
rootpxe_capture_single_disk() {
    local part
    rootpxe_verify_disk_permit_binding "$hd" capture_read_write || handleError "PXEOS_STAGE=permit CODE=CAPTURE_BINDING_CHANGED REASON=source_disk_identity_changed"
    runPartprobe "$hd"
    parts=""
    getPartitions "$hd"
    [[ ${#parts} -gt 0 ]] || handleError "No partitions found ($0)\n   Args Passed: $*"
    rootpxe_partition_progress_plan_disk "$hd" 1

    dots "Saving original partition table"
    savePartitionTablesAndBootLoaders "$hd" 1 "$imagePath" "$osid" "$imgPartitionType"
    echo "Done"
    debugPause

    rootpxe_console_message INFO "Processing disk device: $hd."
    for part in $parts; do
        isBitlockedPartition "$part"
        savePartition "$part" 1 "$imagePath" "$imgPartitionType"
    done
}

beginUpload() {
    local capture_exitcode=0
    local writer_exitcode=0
    case $imgType in
        [Nn])
			rootpxe_capture_single_disk
			;;
        mps)
            rootpxe_verify_disk_permit_binding "$hd" capture_read_write || handleError "PXEOS_STAGE=permit CODE=CAPTURE_BINDING_CHANGED REASON=source_disk_identity_changed"
            parts=""
            getPartitions "$hd"
            [[ ${#parts} -lt 1 ]] && handleError "No partitions found ($0)\n   Args Passed: $*"
            rootpxe_partition_progress_plan_disk "$hd" 1
            rootpxe_console_message INFO "Processing disk device: $hd."
            debugPause
            savePartitionTablesAndBootLoaders "$hd" 1 "$imagePath" "$osid" "$imgPartitionType"
            getPartitions "$hd"
            for part in $parts; do
                isBitlockedPartition "$part"
                savePartition "$part" 1 "$imagePath" "$imgPartitionType"
            done
            ;;
        mpa)
            disk_number=1
            rootpxe_partition_progress_plan_disks "${rootpxe_capture_disks[@]}"
            for disk in "${rootpxe_capture_disks[@]}"; do
                rootpxe_verify_disk_permit_binding "$disk" capture_read_write || handleError "PXEOS_STAGE=permit CODE=CAPTURE_BINDING_CHANGED REASON=source_disk_identity_changed"
                parts=""
                getPartitions "$disk"
                [[ ${#parts} -lt 1 ]] && handleError "PXEOS_STAGE=capture CODE=CAPTURE_SOURCE_CHANGED REASON=partitioned_disk_set_changed"
                debugPause
                rootpxe_console_message INFO "Processing disk device: $disk."
                debugPause
                rootpxe_console_message INFO 'Saving disk size, partition table, and boot loader information.'
                debugPause
                echo -n "${disk_number}:" > ${imagePath}/d${disk_number}.size
                blockdev --getsize64 $disk >> ${imagePath}/d${disk_number}.size
                savePartitionTablesAndBootLoaders "$disk" "$disk_number" "$imagePath" "$osid" "$imgPartitionType"
                runPartprobe "$disk"
                getPartitions "$disk"
                for part in $parts; do
                    isBitlockedPartition "$part"
                    savePartition "$part" "$disk_number" "$imagePath" "$imgPartitionType"
                done
                rootpxe_console_message INFO "Disk device $disk is complete."
                let disk_number+=1
            done
            ;;
        dd)
            rootpxe_verify_disk_permit_binding "$hd" capture_read_write || handleError "PXEOS_STAGE=permit CODE=CAPTURE_BINDING_CHANGED REASON=source_disk_identity_changed"
            rootpxe_partition_progress_plan_whole_disk "$hd" 1
            rootpxe_partition_progress_item "d1:disk" preparing 0 "准备整盘抓取"
            imgpart="$imagePath/$img"
            # A raw image may be intentionally unpartitioned.  Keep a best
            # effort sfdisk dump for the read-only inventory but never turn a
            # missing table into a capture failure.
            sfdisk -d "$hd" >"$imagePath/d1.partitions" 2>/dev/null || rm -f "$imagePath/d1.partitions"
            # uploadFormat owns checked FIFO creation; remove any stale task FIFO first.
            rm -f /tmp/pigz1 >/dev/null 2>&1 || handleError "PXEOS_STAGE=capture CODE=CAPTURE_PIPELINE_SETUP_FAILED REASON=unable_to_clear_capture_fifo"
            if ! rootpxe_partclone_progress_prepare; then
                rm -f /tmp/pigz1 >/dev/null 2>&1 || true
                handleError "PXEOS_STAGE=capture CODE=CAPTURE_PROGRESS_SETUP_FAILED REASON=unable_to_start_partclone_stderr_decoder"
            fi
            if ! uploadFormat "/tmp/pigz1" "$imgpart"; then
                rootpxe_partclone_progress_abort || true
                rm -f /tmp/pigz1 >/dev/null 2>&1 || true
                handleError "PXEOS_STAGE=capture CODE=CAPTURE_PIPELINE_SETUP_FAILED REASON=unable_to_start_capture_writer"
            fi
            rootpxe_partition_progress_item "d1:disk" running 0 "开始整盘复制"
            rootpxe_partition_progress_current_item "d1:disk"
            rootpxe_partclone_progress_start_collector
            if LC_ALL=C TERM="$rootpxe_partclone_progress_term" partclone.imager "${rootpxe_partclone_progress_args[@]}" -c -s "$hd" -O /tmp/pigz1 -f 1 -a0 2>"$rootpxe_partclone_progress_stderr_target"; then
                capture_exitcode=0
            else
                capture_exitcode=$?
            fi
            rootpxe_partclone_progress_wait || progress_decoder_exitcode=$?
            if rootpxe_wait_for_writer "$rootpxe_last_writer_pid"; then
                writer_exitcode=0
            else
                writer_exitcode=$?
            fi
            if [[ $capture_exitcode -ne 0 ]]; then
                rm -f /tmp/pigz1 >/dev/null 2>&1 || true
                handleError "PXEOS_STAGE=capture CODE=CAPTURE_PRODUCER_FAILED REASON=partclone_capture_failed"
            fi
            if [[ ${progress_decoder_exitcode:-0} -ne 0 ]]; then
                rm -f /tmp/pigz1 >/dev/null 2>&1 || true
                handleError "PXEOS_STAGE=capture CODE=CAPTURE_PROGRESS_FAILED REASON=partclone_stderr_decoder_failed"
            fi
            if [[ $writer_exitcode -ne 0 ]]; then
                rm -f /tmp/pigz1 >/dev/null 2>&1 || true
                handleError "PXEOS_STAGE=capture CODE=CAPTURE_PIPELINE_FAILED REASON=storage_writer_or_compressor_failed"
            fi
            rm /tmp/pigz1 >/dev/null 2>&1 || handleError "PXEOS_STAGE=capture CODE=CAPTURE_ARTIFACT_FINALIZE_FAILED REASON=unable_to_cleanup_capture_fifo"
            rootpxe_partition_progress_item "d1:disk" completed 100 "整盘抓取完成"
            rootpxe_partition_progress_clear_current_item
            clearScreen
            ;;
    esac
}
if [[ ${imgType:-} == [Nn] ]]; then
    rootpxe_lvm_capture_preflight "$hd" "$imagePath" || handleError "PXEOS_STAGE=capture CODE=LVM_TOPOLOGY_UNSUPPORTED REASON=single_pv_single_vg_linear_lvs_required"
fi
if [[ ${imgType:-} == mps ]]; then
    rootpxe_disk_has_lvm_pv "$hd" && handleError "PXEOS_STAGE=capture CODE=LVM_RAW_UNSUPPORTED REASON=mps_requires_non_lvm_partition_inventory"
elif [[ ${imgType:-} == mpa ]]; then
    for disk in "${rootpxe_capture_disks[@]}"; do
        rootpxe_disk_has_lvm_pv "$disk" && handleError "PXEOS_STAGE=capture CODE=LVM_RAW_UNSUPPORTED REASON=mpa_requires_non_lvm_partition_inventory"
    done
fi
rootpxe_stage init "pxeos upload started, storage mounted"
rootpxe_console_message INFO 'Capturing image with Partclone.'
debugPause
beginUpload
rootpxe_wait_for_writers
completeTasking
