#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
. /bin/pxeos.checkin
. /bin/pxeos.mount
. /bin/pxeos.checkmount
. /bin/pxeos.checkmountdrivesize
. /bin/pxeos.checkimgvar
rootpxe_require_task_context || handleError "Invalid task context ($0)"
imagePath="/storage/dev/$macWinSafe"
parts=""
part=""
disks=""
disk=""
hd=""
rootpxe_console_message INFO 'Preparing to send image file to server.'
percent="$pct"
[[ $pct -lt 5 || $pct -ge 100 ]] && percent=5
pxeos.statusreporter "$mac" "${pxeapi:-$web}" "$taskid" & disown
statusReporter="$!"
prepareUploadLocation "$imagePath"
printf '%s\n' "$taskid" > "$imagePath/.rootpxe-capture-taskid" || handleError "Could not initialize capture task marker ($0)"
rootpxe_console_message INFO "Using image: $img."
# A resizable single-disk image keeps the captured partition layout intact.
# d1.partitions is both the capture fact and the minimum deployment layout;
# administrators may only grow partitions later during deployment.  Capturing
# must therefore never shrink, move, or restore the source disk.
rootpxe_capture_single_disk() {
    local part
    runPartprobe "$hd"
    parts=""
    getPartitions "$hd"
    [[ ${#parts} -gt 0 ]] || handleError "No partitions found ($0)\n   Args Passed: $*"

    dots "Saving original partition table"
    savePartitionTablesAndBootLoaders "$hd" 1 "$imagePath" "$osid" "$imgPartitionType"
    echo "Done"
    debugPause

    rootpxe_console_message INFO "Processing disk device: $hd."
    for part in $parts; do
        isBitlockedPartition "$part"
        savePartition "$part" 1 "$imagePath" "$imgPartitionType"
    done
    rootpxe_capture_lvm_volumes "$imagePath" || handleError "PXEOS_STAGE=capture CODE=LVM_CAPTURE_FAILED REASON=metadata_or_lv_writer_failed"
}

beginUpload() {
    local capture_exitcode=0
    local writer_exitcode=0
    case $imgType in
        [Nn])
			rootpxe_capture_single_disk
			;;
        mps)
            parts=""
            getPartitions "$hd"
            [[ ${#parts} -lt 1 ]] && handleError "No partitions found ($0)\n   Args Passed: $*"
            rootpxe_console_message INFO "Processing disk device: $hd."
            debugPause
            savePartitionTablesAndBootLoaders "$hd" 1 "$imagePath" "$osid" "$imgPartitionType"
            getPartitions "$hd"
            for part in $parts; do
                isBitlockedPartition "$part"
                savePartition "$part" 1 "$imagePath" "$imgPartitionType"
            done
            ;;
        mpa)
            disk_number=1
            for disk in $disks; do
                [[ $disk =~ mmcblk[0-9]+boot[0-9]+ ]] && continue
                parts=""
                getPartitions "$disk"
                [[ ${#parts} -lt 1 ]] && continue
                debugPause
                rootpxe_console_message INFO "Processing disk device: $disk."
                debugPause
                rootpxe_console_message INFO 'Saving disk size, partition table, and boot loader information.'
                debugPause
                echo -n "${disk_number}:" > ${imagePath}/d${disk_number}.size
                blockdev --getsize64 $disk >> ${imagePath}/d${disk_number}.size
                savePartitionTablesAndBootLoaders "$disk" "$disk_number" "$imagePath" "$osid" "$imgPartitionType"
                runPartprobe "$disk"
                getPartitions "$disk"
                for part in $parts; do
                    isBitlockedPartition "$part"
                    savePartition "$part" "$disk_number" "$imagePath" "$imgPartitionType"
                done
                rootpxe_console_message INFO "Disk device $disk is complete."
                let disk_number+=1
            done
            ;;
        dd)
            imgpart="$imagePath/$img"
            # A raw image may be intentionally unpartitioned.  Keep a best
            # effort sfdisk dump for the read-only inventory but never turn a
            # missing table into a capture failure.
            sfdisk -d "$hd" >"$imagePath/d1.partitions" 2>/dev/null || rm -f "$imagePath/d1.partitions"
            # uploadFormat owns checked FIFO creation; remove any stale task FIFO first.
            rm -f /tmp/pigz1 >/dev/null 2>&1 || handleError "PXEOS_STAGE=capture CODE=CAPTURE_PIPELINE_SETUP_FAILED REASON=unable_to_clear_capture_fifo"
            uploadFormat "/tmp/pigz1" "$imgpart"
            if partclone.imager -c -s "$hd" -O /tmp/pigz1 -N -f 1 -a0; then
                capture_exitcode=0
            else
                capture_exitcode=$?
            fi
            if rootpxe_wait_for_writer "$rootpxe_last_writer_pid"; then
                writer_exitcode=0
            else
                writer_exitcode=$?
            fi
            if [[ $capture_exitcode -ne 0 ]]; then
                rm -f /tmp/pigz1 >/dev/null 2>&1 || true
                handleError "PXEOS_STAGE=capture CODE=CAPTURE_PRODUCER_FAILED REASON=partclone_capture_failed"
            fi
            if [[ $writer_exitcode -ne 0 ]]; then
                rm -f /tmp/pigz1 >/dev/null 2>&1 || true
                handleError "PXEOS_STAGE=capture CODE=CAPTURE_PIPELINE_FAILED REASON=storage_writer_or_compressor_failed"
            fi
            rm /tmp/pigz1 >/dev/null 2>&1 || handleError "PXEOS_STAGE=capture CODE=CAPTURE_ARTIFACT_FINALIZE_FAILED REASON=unable_to_cleanup_capture_fifo"
            clearScreen
            ;;
    esac
}
findHDDInfo
if [[ ${imgType:-} == [Nn] ]]; then
    rootpxe_lvm_capture_preflight "$hd" "$imagePath" || handleError "PXEOS_STAGE=capture CODE=LVM_TOPOLOGY_UNSUPPORTED REASON=single_pv_single_vg_linear_lvs_required"
fi
capture_target_id=$(rootpxe_disk_stable_identity "$hd") || handleError "PXEOS_STAGE=permit CODE=TARGET_IDENTITY_UNAVAILABLE REASON=unable_to_bind_capture_disk"
while :; do
    if rootpxe_wait_for_disk_permit "$capture_target_id" capture_read_write; then
        permit_result=0
    else
        permit_result=$?
    fi
    case $permit_result in
        0) break ;;
        10) printf '%s\n' reboot > /tmp/pxeos.failure_action; exit 2 ;;
        20) exit 2 ;;
        *)
            rootpxe_console_message WARN 'Disk permit wait was interrupted. Retrying in 5s.'
            sleep 5
            ;;
    esac
done
rootpxe_stage init "pxeos upload started, storage mounted"
rootpxe_console_message INFO 'Capturing image with Partclone.'
debugPause
beginUpload
rootpxe_wait_for_writers
completeTasking
