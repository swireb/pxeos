#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh || exit 1
if [[ -n $mode && $mode != +(*debug*) && -z $type ]]; then
    case $mode in
        wipe)
            pxeos.wipe
            ;;
        checkdisk)
            pxeos.testdisk
            ;;
        photorec)
            pxeos.photorec
            ;;
        badblocks)
            pxeos.surfacetest
            ;;
        clamav)
            pxeos.av
            ;;
        manreg)
            pxeos.man.reg
            ;;
        inventory)
            pxeos.inventory
            ;;
        winpassreset)
            pxeos.chntpw
            ;;
        quickimage)
            pxeos.quickimage
            ;;
        sysinfo)
            pxeos.sysinfo
            ;;
        *)
            handleError "Fatal Error: Unknown mode :: $mode ($0)\n   Args Passed: $*"
            ;;
    esac
else
    case $type in
        down)
            pxeos.download
            ;;
        up)
            pxeos.upload
            ;;
        *)
            [[ -z $type ]] && type="Null"
            handleError "Fatal Error: Unknown request type :: $type"
            ;;
    esac
fi
