#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
. /bin/pxeos.checkin

pxeos_av_diag_warn() {
    printf '[WARN]  Diagnostic log: unavailable.\n' >&2
}

pxeos_av_diag_begin() {
    unset rootpxe_log_raw_path
    pxeos_av_diag_raw=''
    if rootpxe_log_raw_file; then
        pxeos_av_diag_raw=$rootpxe_log_raw_path
        return 0
    fi
    pxeos_av_log_published=no
    pxeos_av_diag_warn
    return 1
}

pxeos_av_prepare_task_log() {
    if rootpxe_log_new_file clamav.log; then
        pxeos_av_log_ready=yes
        pxeos_av_log_published=no
        return 0
    fi
    pxeos_av_log_ready=no
    pxeos_av_log_published=no
    pxeos_av_diag_warn
    return 1
}

pxeos_av_diag_reference() {
    local dir file
    [[ ${pxeos_av_log_ready:-no} == yes && ${pxeos_av_log_published:-no} == yes ]] || return 1
    dir=$(rootpxe_log_directory) || return 1
    file="$dir/clamav.log"
    [[ -f $file && ! -L $file && -O $file ]] || return 1
    [[ $(LC_ALL=C stat -c %a -- "$file" 2>/dev/null) == 600 ]] || return 1
    printf ' Diagnostic log: %s' "$file"
}

pxeos_av_scan_prepare() {
    pxeos_av_scan_log=''
    if ! pxeos_av_diag_begin; then
        handleError "Unable to prepare ClamAV diagnostic log. ($0)$(pxeos_av_diag_reference)"
        return 1
    fi
    pxeos_av_scan_log=$pxeos_av_diag_raw
}

pxeos_av_diag_finish() {
    local raw="$1" operation="$2" status=0 published=no
    if [[ -n $raw ]]; then
        if rootpxe_log_publish clamav.log "$raw" "$operation" yes; then
            published=yes
        else
            pxeos_av_diag_warn
            status=1
        fi
        if ! rm -f -- "$raw"; then
            pxeos_av_diag_warn
            status=1
            published=no
        fi
    fi
    pxeos_av_log_published=$published
    return "$status"
}

pxeos_av_run_logged() {
    local operation="$1" raw='' status=0
    shift
    if pxeos_av_diag_begin; then raw=$pxeos_av_diag_raw; fi
    if [[ -n $raw ]]; then
        "$@" >"$raw" 2>&1
        status=$?
    else
        "$@" >/dev/null 2>&1
        status=$?
    fi
    pxeos_av_diag_finish "$raw" "$operation" >/dev/null || true
    return "$status"
}

pxeos_av_found_lines() {
    grep 'FOUND' -- "$1" | tr -d '\000'
}

clearScreen
displayBanner
disks=""
disk=""
hd=""
parts=""
part=""
sysuuid=$(dmidecode -s system-uuid)
sysuuid=${sysuuid,,}
pxeos_av_prepare_task_log || true
dots "Mounting Clamav"
[[ ! -d /opt/pxeos/clamav ]] && mkdir -p /opt/pxeos/clamav >/dev/null 2>&1
pxeos_av_run_logged clamav_mount_remote mount -o nolock,proto=tcp,rsize=32768,wsize=32768,intr,noatime $clamav /opt/pxeos/clamav
mount_rc=$?
if [[ ! $mount_rc -eq 0 ]]; then
    echo "Failed"
    debugPause
    handleError "Unable to mount location. ($0)$(pxeos_av_diag_reference)"
fi
echo "Done"
debugPause
dots "Adding clamav to path"
if [[ -d /opt/pxeos/clamav/bin && -d /opt/pxeos/clamav/sbin ]]; then
    export PATH="$PATH:/opt/pxeos/clamav/bin:/opt/pxeos/clamav/sbin"
else
    echo "Failed"
    debugPause
    handleError "Cannot find clamav binaries to run task. ($0)"
fi
echo "Done"
debugPause
dots "Updating clamav"
pxeos_av_run_logged clamav_freshclam freshclam
case $? in
    0)
        echo "Done"
        ;;
    *)
        echo "Failed"
        debugPause
        handleError "Unable to update clamav definitions. ($0)"
        ;;
esac
debugPause
echo "Done"
debugPause
dots "Getting disks to scan"
getHardDisk 'true'
if [[ -z $disks ]]; then
    echo "Failed"
    debugPause
    handleError "Unable to find any disks. ($0)"
fi
echo "Done"
debugPause
dots "Creating scan partition"
[[ ! -d /clamavscan ]] && mkdir -p /clamavscan >/dev/null 2>&1
if [[ ! -d /clamavscan ]]; then
    echo "Failed"
    debugPause
    handleError "Unable to create scan folder. ($0)"
fi
echo "Done"
debugPause
action=""
case $avmode in
    [Ss])
        modename="Scan and Report"
        ;;
    [Qq])
        action="--move=/clamavscan/pxeos/infected"
        modename="Scan and Quarantine"
        ;;
    *)
        handleError "Unable to determine scanning mode! ($0)"
        ;;
esac
for disk in $disks; do
    dots "Using disk device"
    echo "$disk"
    debugPause
    getPartitions "$disk"
    for part in $parts; do
        isBitlockedPartition "$part"
        fsTypeSetting "$part"
        case $fstype in
            [Nn][Tt][Ff][Ss])
        rootpxe_console_message INFO "Mounting partition $part."
                pxeos_av_run_logged clamav_partition_mount ntfs-3g -o remove_hiberfile,rw $part /clamavscan
                ;;
            [Ee][Xx][Tt][Ff][Ss])
        rootpxe_console_message INFO "Mounting partition $part."
                pxeos_av_run_logged clamav_partition_mount mount -o rw $part /clamavscan
                ;;
            *)
                dots "Not scanning partition"
                echo "$part"
                debugPause
                continue
                ;;
        esac
        mount_rc=$?
        [[ ! $mount_rc -eq 0 ]] && handleError "Could not mount partition ($0)$(pxeos_av_diag_reference)"
        debugPause
        dots "Creating working directories"
        mkdir -p /clamavscan/pxeos/{tmp,infected} >/dev/null 2>&1
        case $? in
            0)
                echo "Done"
                ;;
            *)
                echo "Failed"
                debugPause
                umount /clamavscan >/dev/null 2>&1
                continue
                ;;
        esac
        debugPause
rootpxe_console_message INFO "Scanning partition $part."
        debugPause
        dots "Clam AV Mode"
        echo "$modename"
        debugPause
        dots "Starting AV scan"
        echo -e -n "\t"
        pxeos_av_run_logged clamav_version clamscan -V
        case $? in
            0)
                echo "Done"
                ;;
            *)
                echo "Failed"
                debugPause
                umount /clamavscan >/dev/null 2>&1
                continue
                ;;
        esac
        debugPause
        cd /clamavscan
        dots "Scanning"
        start=$(date +%s)
        if ! pxeos_av_scan_prepare; then
            umount /clamavscan >/dev/null 2>&1
            continue
        fi
        scan_log=$pxeos_av_scan_log
        clamscan -r --tempdir=/clamavscan/pxeos/tmp $action --log=$scan_log --no-summary --exclude-dir=/clamavscan/pxeos/*
        scan_rc=$?
        case $scan_rc in
            0)
rootpxe_console_message INFO 'Scan complete. Processing the log file.'
                ;;
            *)
                echo "Failed"
                debugPause
                umount /clamavscan
                pxeos_av_diag_finish "$pxeos_av_scan_log" "clamav_scan:exit=$scan_rc" >/dev/null || true
                cur=$(date +%s)
                diff=$((cur - start))
rootpxe_console_message WARN 'ClamAV failed.'
rootpxe_console_message WARN 'The virus database files may be unavailable.'
rootpxe_console_message INFO 'Trying the next partition.'
                debugPause
                continue
                ;;
        esac
        debugPause
        output=$(pxeos_av_found_lines "$scan_log")
        oIFS=$IFS
        IFS=$'\n'
        cnt=0
        for line in $output; do
            b64=$(echo $line | base64)
            let cnt+=1
rootpxe_console_message INFO "File ID: $cnt."
            dots "Sending file id"
            curl -Lks --data "sysuuid=${sysuuid}&mac=$mac&string=$b64&mode=$avmode" ${web}service/av.php 2>/dev/null
            case $? in
                0)
                    echo "Done"
                    ;;
                *)
                    echo "Failed"
                    debugPause
                    continue
                    ;;
            esac
            debugPause
            cat /tmp/avstat
            cat /dev/null > /tmp/avstat
        done
        IFS=$oIFS
        pxeos_av_diag_finish "$pxeos_av_scan_log" clamav_scan:exit=0 >/dev/null || true
        umount /clamavscan >/dev/null 2>&1
    done
done
. /bin/pxeos.nonimgcomplete
