#!/bin/bash
[[ $mode == +(*capone*) ]] && return
. /usr/share/pxeos/lib/funcs.sh
[[ $deployed -eq 1 ]] && . /bin/pxeos.checkin
rootpxe_api="${pxeapi:-$web}"
task_mode=0
if [[ ${taskid:-0} =~ ^[1-9][0-9]*$ ]]; then
    task_mode=1
    rootpxe_require_task_context || handleError "RootPXE: inventory task context is invalid ($0)"
fi
getHardDisk
doInventory
gpu_array_length=${#graphics_vendors_array[@]}
inventory_section() {
    rootpxe_console_message INFO "$1:"
}
inventory_field() {
    local label="$1" value="${2-}"
    rootpxe_console_message INFO "$label: $value"
}
if [[ -z $1 ]]; then
    inventory_section 'System information'
    inventory_field 'System manufacturer' "$sysman"
    inventory_field 'System product name' "$sysproduct"
    inventory_field 'System version' "$sysversion"
    inventory_field 'System serial number' "$sysserial"
    inventory_field 'System UUID' "$sysuuid"
    inventory_field 'Computer form factor' "$systype"
    usleep 1000000
    inventory_section 'BIOS information'
    inventory_field 'BIOS version' "$biosversion"
    inventory_field 'BIOS vendor' "$biosvendor"
    inventory_field 'BIOS date' "$biosdate"
    usleep 1000000
    inventory_section 'Motherboard information'
    inventory_field 'Motherboard manufacturer' "$mbman"
    inventory_field 'Motherboard product name' "$mbproductname"
    inventory_field 'Motherboard product version' "$mbversion"
    inventory_field 'Motherboard serial number' "$mbserial"
    inventory_field 'Motherboard asset tag' "$mbasset"
    usleep 1000000
    inventory_section 'CPU information'
    inventory_field 'CPU manufacturer' "$cpuman"
    inventory_field 'CPU version' "$cpuversion"
    inventory_field 'CPU current speed' "$cpucurrent"
    inventory_field 'CPU maximum speed' "$cpumax"
    usleep 1000000
    inventory_section 'Memory information'
    inventory_field 'Memory' "$mem"
    usleep 1000000
    inventory_section 'Disk device information'
    inventory_field 'Disk device' "$hdinfo"
    usleep 1000000
    inventory_section 'Case information'
    inventory_field 'Case manufacturer' "$caseman"
    inventory_field 'Case version' "$casever"
    inventory_field 'Case serial number' "$caseserial"
    inventory_field 'Case asset number' "$caseasset"
    usleep 1000000
    inventory_section 'GPU information'
    for (( i=0; i<$gpu_array_length; i++ )); do
        inventory_field "GPU $i manufacturer" "${graphics_vendors_array[$i]}"
        inventory_field "GPU $i product" "${graphics_products_array[$i]}"
    done
fi
poststring="mac=${mac}&sysman=${sysman64}&sysproduct=${sysproduct64}&sysversion=${sysversion64}&sysserial=${sysserial64}&sysuuid=${sysuuid64}&systype=${systype64}&biosversion=${biosversion64}&biosvendor=${biosvendor64}&biosdate=${biosdate64}&mbman=${mbman64}&mbproductname=${mbproductname64}&mbversion=${mbversion64}&mbserial=${mbserial64}&mbasset=${mbasset64}&cpuman=${cpuman64}&cpuversion=${cpuversion64}&cpucurrent=${cpucurrent64}&cpumax=${cpumax64}&mem=${mem64}&hdinfo=${hdinfo64}&caseman=${caseman64}&casever=${casever64}&caseserial=${caseserial64}&caseasset=${caseasset64}&gpuvendors=${inventory_graphics_vendor64}&gpuproducts=${inventory_graphics_product64}"
count=0
res=""
while [[ -z $res ]]; do
    dots "Attempting to send inventory"
    inventory_args=(--data "$poststring")
    if [[ $task_mode -eq 1 ]]; then
        inventory_args+=(--data-urlencode "taskid=$taskid" --data-urlencode "token=$task_token" --data-urlencode "mac=$mac")
    fi
    res=$(curl -Lksf \
        "${inventory_args[@]}" \
        "${rootpxe_api}inventory" 2>/dev/null)
    if [[ $count -ge 10 ]]; then
        echo "Failed"
        debugPause
        [[ $task_mode -eq 0 ]] && break
        handleError "Could not send task inventory ($0)"
    fi
    if [[ -z $res ]]; then
        let count+=1
        usleep 2000000
    fi
done
echo "Done"
debugPause
[[ $deployed -eq 1 ]] && . /bin/pxeos.nonimgcomplete $mac
