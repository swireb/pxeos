#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh || exit 1
. /usr/share/pxeos/lib/disk-health.sh
RUN_CHKDSK=""
OS_ID_WIN7=5
OS_ID_WIN8=6
# The direct manual-registration handoff has only task identity before checkin.
# Do not derive OS, partition, multicast, or disk state from absent old kernel
# arguments; authenticated checkin supplies those values first.
pxeos_checkin_runtime_setup() {
    local arg
    for arg in $(cat /proc/cmdline | tr -d \\0); do
        case $arg in
            initsh)
                ash -i
                ;;
            nombr)
                nombr=1
                ;;
            *)
                [[ ${imgPartitionType:-} != all && ${imgPartitionType:-} != mbr ]] && nombr=1
                ;;
        esac
    done
    clearScreen
    displayBanner
    osname=""
    mbrfile=""
    macWinSafe="$(echo -n "$mac" | tr '[:upper:]' '[:lower:]' | tr -cd '0-9a-f')"
    sockets=$(grep "physical id" /proc/cpuinfo|sort -u|wc -l)
    arch=$(uname -m)
    [[ ${chkdsk:-0} -eq 1 ]] && RUN_CHKDSK="-x"
    case ${mc:-} in
        yes) method="UDPCAST" ;;
        bt) method="Torrent-CAST" ;;
        *) method="" ;;
    esac
    debugPause
    verifyNetworkConnection
    dots "Checking Operating System"
    [[ -z ${deployed:-} ]] && determineOS "$osid"
    echo "$osname"
    dots "Checking CPU Cores"
    cores=$(nproc)
    echo "$cores"
    blGo=0
    nfsServerName=""
}
rootpxe_api="${pxeapi:-$web}"

rootpxe_json_get_string() {
    local document="$1" query="$2"
    # Do not use jq -e or `// empty`: jq treats false as a failed result, and
    # an invalid nested access must remain a parser failure rather than being
    # silently replaced with an empty shell variable.
    jq -r "$query | if type == \"string\" or type == \"number\" or type == \"boolean\" then . else empty end" <<<"$document" 2>/dev/null
}

rootpxe_json_get_text() {
    local document="$1" query="$2"
    jq -r "$query | strings" <<<"$document" 2>/dev/null
}

rootpxe_json_assign() {
    local document="$1" name="$2" query="$3" value
    value=$(rootpxe_json_get_string "$document" "$query") || return 1
    printf -v "$name" '%s' "$value"
}

rootpxe_json_assign_text() {
    local document="$1" name="$2" query="$3" value
    value=$(rootpxe_json_get_text "$document" "$query") || return 1
    printf -v "$name" '%s' "$value"
}

# v1 身份策略只接受服务端冻结后的 JSON；不从内核参数或环境读取。策略
# 文件随后由下载流程读取，权限避免执行令牌或部署计划被其他本地进程读取。
rootpxe_apply_json_deployment_identity_policy() {
    local document="$1" policy_file=/tmp/pxeos.deployment-identity-policy.json
    rm -f -- "$policy_file"
    unset deploymentIdentityPolicyFile
    jq -e '
      if has("deploymentIdentityPolicy") | not then ([has("cloudInitUserData"),has("cloudInitUserDataSha256"),has("cloudInitMetaData"),has("cloudInitMetaDataSha256"),has("cloudInitInstanceId"),has("cloudInitHostname"),has("cloudInitNetworkConfig"),has("cloudInitNetworkConfigSha256"),has("cloudInitVendorData"),has("cloudInitVendorDataSha256")] | any | not)
      else .deploymentIdentityPolicy as $p |
        ($p | type == "object") and $p.version == 1 and
        (($p | keys - ["version","systemIdentity","taskHostname","cloudInit"]) | length == 0) and
        ($p.systemIdentity | type == "object" and keys == ["sysprep"]) and
        ($p.systemIdentity.sysprep | type == "boolean") and
        ($p.cloudInit | type == "boolean") and
        (if $p | has("taskHostname") then ($p.taskHostname | type == "string") else true end) and
        (if $p.cloudInit then .type == "deploy" and .osid == 50 and has("cloudInitUserData") and has("cloudInitUserDataSha256") and has("cloudInitMetaData") and has("cloudInitMetaDataSha256") and has("cloudInitNetworkConfig") and has("cloudInitNetworkConfigSha256") and has("cloudInitVendorData") and has("cloudInitVendorDataSha256") and (has("cloudInitInstanceId")|not) and (has("cloudInitHostname")|not)
         else ([has("cloudInitUserData"),has("cloudInitUserDataSha256"),has("cloudInitMetaData"),has("cloudInitMetaDataSha256"),has("cloudInitInstanceId"),has("cloudInitHostname"),has("cloudInitNetworkConfig"),has("cloudInitNetworkConfigSha256"),has("cloudInitVendorData"),has("cloudInitVendorDataSha256")] | any | not) end)
      end' >/dev/null 2>&1 <<<"$document" || return 1
    if jq -e 'has("deploymentIdentityPolicy")' >/dev/null <<<"$document"; then
        (umask 077; jq -c '.deploymentIdentityPolicy' <<<"$document" >"$policy_file") || { rm -f -- "$policy_file"; return 1; }
        chmod 600 "$policy_file" || { rm -f -- "$policy_file"; return 1; }
        deploymentIdentityPolicyFile="$policy_file"
        export deploymentIdentityPolicyFile
    fi
}

rootpxe_apply_json_partition_inventory() {
    local document="$1" inventory_file
    rm -f -- "${partitionInventoryFile:-}"
    unset partitionInventoryFile partitionInventoryHash
    jq -e 'if has("partitionInventory") then (.partitionInventory | type == "object") and (.partitionInventory.version == 1) and ((.partitionInventory.disks|type) == "array") and (.partitionInventory.disks|length > 0) and (.partitionInventoryHash|type == "string" and test("^[a-f0-9]{64}$")) else true end' >/dev/null <<<"$document" || return 1
    jq -e 'has("partitionInventory")' >/dev/null <<<"$document" || return 0
    inventory_file=$(mktemp /tmp/rootpxe-inventory.XXXXXX) || return 1
    jq -cS '.partitionInventory' <<<"$document" >"$inventory_file" || { rm -f -- "$inventory_file"; return 1; }
    chmod 600 "$inventory_file" || { rm -f -- "$inventory_file"; return 1; }
    partitionInventoryFile="$inventory_file"
    partitionInventoryHash=$(jq -r '.partitionInventoryHash' <<<"$document")
    export partitionInventoryFile partitionInventoryHash
}

rootpxe_write_checkin_json_payload() {
    local output_file="$1" token_file capabilities storage_capabilities storage_boot identity_versions='[1]' old_umask result
    [[ ${taskid:-} =~ ^[1-9][0-9]*$ && -n ${task_token:-} && -n ${lmac:-} ]] || return 1
    [[ -n $output_file && ! -L $output_file ]] || return 1
    capabilities=$(rootpxe_deployment_identity_capabilities_json) && rootpxe_deployment_identity_capabilities_valid "$capabilities" || return 1
    rootpxe_storage_capabilities || return 1
    storage_capabilities=$("$rootpxe_storage_helper" --capabilities) || return 1
    storage_boot=$(cat /proc/sys/kernel/random/boot_id) || return 1
    [[ $storage_boot =~ ^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$ ]] || return 1
    rootpxe_storage_boot_id=$storage_boot
    rootpxe_storage_sysuuid=${sysuuid_local:-}
    export rootpxe_storage_boot_id rootpxe_storage_sysuuid
    # Never put the execution token in jq's argv. Keep it in a short-lived,
    # owner-only file while jq constructs the owner-only curl request body.
    old_umask=$(umask)
    umask 077
    token_file=$(mktemp /tmp/rootpxe-checkin-token.XXXXXX) || { umask "$old_umask"; return 1; }
    chmod 600 "$token_file" || { rm -f -- "$token_file"; umask "$old_umask"; return 1; }
    printf '%s' "$task_token" >"$token_file" || { rm -f -- "$token_file"; umask "$old_umask"; return 1; }
	jq -cn \
        --argjson taskId "$taskid" \
		--rawfile token "$token_file" \
        --arg mac "$lmac" \
        --arg sysuuid "${sysuuid_local:-}" \
        --argjson versions "$identity_versions" \
        --argjson capabilities "$capabilities" \
        --argjson storageCapabilities "$storage_capabilities" --arg storageBootId "$storage_boot" \
		'{taskId:$taskId,token:$token,mac:$mac,sysuuid:$sysuuid,format:"json",cloudInitCapability:"linux-nocloud-v5",deploymentIdentityProtocolVersions:$versions,deploymentIdentityCapabilities:$capabilities,storageProtocolVersions:[1],storageCapabilities:$storageCapabilities,storageBootId:$storageBootId}' >"$output_file"
	result=$?
	: >"$token_file"
	rm -f -- "$token_file"
	umask "$old_umask"
	return "$result"
}

# The health report is a host snapshot, independent from an image's chosen
# source or target disk.  Only a successful lsblk enumeration with zero real
# disks is a task error; tool, parsing, and upload failures remain best effort.
rootpxe_report_disk_health_after_checkin() {
    local health_result
    if rootpxe_send_disk_health; then
        health_result=0
    else
        health_result=$?
    fi
    case $health_result in
        0) return 0 ;;
        2) handleError 'PXEOS_STAGE=inventory CODE=NO_DISKS_DETECTED REASON=no_physical_disks' ;;
        *) return 0 ;;
    esac
}

rootpxe_validate_json_storage() {
    protocol=${protocol,,}
    [[ -n ${storage_server:-} && $storage_server != *$'\n'* && $storage_server != *$'\r'* ]] || return 1
    case $protocol in
        smb)
            storage_export=$(rootpxe_validate_smb_export "${storage_export:-}") || return 1
            [[ -n ${smb_username:-} && -n ${smb_password:-} ]] || return 1
            ;;
        nfs)
            [[ ${storage_export:-} == /* && $storage_export != *[[:cntrl:]]* && $storage_export != *\\* ]] || return 1
            if [[ $storage_export != / ]]; then
                IFS=/ read -r -a storage_root_parts <<<"${storage_export#/}"
                for root_part in "${storage_root_parts[@]}"; do [[ -n $root_part && $root_part != . && $root_part != .. ]] || return 1; done
            fi
            ;;
        *) return 1 ;;
    esac
}

# RootPXE JSON exposes a human-level positive compressionLevel (for example
# 6).  PXEOS historically passes PIGZ_COMP directly to pigz/zstd, whose
# command-line form is negative.  Keep legacy negative values valid, but do
# not accept an unbounded value from an untrusted checkin response.
rootpxe_normalize_compression_level() {
    local value="$1" level
    [[ $value =~ ^-?[0-9]+$ ]] || return 1
    level=${value#-}
    [[ $level =~ ^[1-9][0-9]*$ ]] && ((level <= 22)) || return 1
    printf '%s\n' "-$level"
}

rootpxe_validate_pigz_compression() {
    local value="$1" format="$2" level
    [[ $value =~ ^-[1-9][0-9]*$ ]] || return 1
    level=${value#-}
    ((level <= 22)) || return 1
    # gzip/pigz only supports levels 1..9; zstd formats retain 1..22.
    case "$format" in
        0|2) ((level <= 9)) || return 1 ;;
    esac
}

# JSON checkin uses an explicit whitelist.  Never eval/source response content.
rootpxe_apply_json_checkin() {
    local document="$1" value
    rootpxe_cloud_init_cleanup_private || return 1
    command -v jq >/dev/null 2>&1 || return 1
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$document" || return 1
    rootpxe_json_assign "$document" waitFlag '.wait' || return 1
    [[ -z $waitFlag || $waitFlag == true || $waitFlag == false ]] || return 1
    [[ $waitFlag == true ]] && waitFlag=1
    [[ $waitFlag == false ]] && waitFlag=0
    rootpxe_json_assign "$document" waitMsg '.message' || return 1
    rootpxe_json_assign "$document" retryAfterSec '.retryAfterSec // .retry_after_sec' || return 1
    [[ -z $retryAfterSec || $retryAfterSec =~ ^[1-9][0-9]{0,2}$ ]] || return 1
    retryAfterSec=${retryAfterSec:-5}
    if [[ $waitFlag == 1 ]]; then
        # Queue replies intentionally omit task/storage fields.  Clear state
        # from an earlier response so a later retry cannot mount with stale
        # protocol, path, or SMB credentials.
        protocol="" storage_server="" storage_export=""
        smb_username="" smb_password="" smb_domain=""
        rootpxe_multicast_reset
        rootpxe_cloud_init_cleanup_private || return 1
        export protocol storage_server storage_export
        return 0
    fi
    rootpxe_json_assign "$document" errorMsg '.error' || return 1
    [[ -z $errorMsg ]] || handleError "RootPXE checkin rejected by server ($0)"
    rootpxe_json_assign "$document" taskid '.taskId // .taskid' || return 1
    rootpxe_json_assign "$document" progress_attempt '.progressAttempt // .progress_attempt // 1' || return 1
    [[ $progress_attempt =~ ^[1-9][0-9]*$ ]] || return 1
    rootpxe_partition_progress_enabled=$(jq -r 'if ((.progressProtocolVersions // []) | index(2)) then "yes" else "no" end' <<<"$document" 2>/dev/null) || return 1
    rootpxe_json_assign_text "$document" execution_token '.executionToken // .execution_token' || return 1
    local failure_policy
    failure_policy=$(jq -er '
      (if has("failureWaitSec") then .failureWaitSec else 600 end) as $wait |
      (if has("failureAction") then .failureAction else "reboot" end) as $action |
      if ($wait|type) == "number" and ($wait|floor) == $wait and $wait >= 60 and $wait <= 3600
        and ($action == "reboot" or $action == "shutdown")
      then [$wait,$action]|@tsv else error("invalid failure policy") end' <<<"$document") || return 1
    IFS=$'\t' read -r rootpxe_failure_wait_sec rootpxe_failure_action <<<"$failure_policy"
    export rootpxe_failure_wait_sec rootpxe_failure_action
    rootpxe_json_assign_text "$document" taskType '.type' || return 1
    rootpxe_json_assign_text "$document" pxe_type '.pxeType // .pxe_type' || return 1
    rootpxe_json_assign_text "$document" reply_mac '.mac' || return 1
    rootpxe_json_assign_text "$document" img '.img // .imagePath' || return 1
    rootpxe_json_assign_text "$document" img_type '.imgType // .img_type' || return 1
    rootpxe_json_assign_text "$document" img_partition_type '.imgPartitionType // .img_partition_type' || return 1
    rootpxe_json_assign "$document" osid '.osid' || return 1
    rootpxe_json_assign "$document" img_format '.imgFormat // .img_format' || return 1
    # JSON now uses a positive compressionLevel.  Older JSON emitters may
    # still provide the legacy negative pigzComp/pigz_comp form.
    rootpxe_json_assign "$document" pigz_comp '.compressionLevel // .pigzComp // .pigz_comp' || return 1
    [[ -z $pigz_comp ]] || pigz_comp=$(rootpxe_normalize_compression_level "$pigz_comp") || return 1
    rootpxe_json_assign "$document" shutdown '.shutdown' || return 1
    storage_server="" storage_export="" smb_username="" smb_password="" smb_domain=""
    # A top-level protocol is authoritative.  Only legacy NFS JSON that omits
    # it may obtain the protocol from a nested storage object; an explicit
    # unknown top-level value must fail closed instead of falling back.
    rootpxe_json_assign_text "$document" protocol 'if has("protocol") then .protocol elif (.storage? | type == "object") then .storage.protocol else empty end' || return 1
    protocol=${protocol,,}
    case $protocol in
        smb)
            # SMB accepts only the current RootPXE flat response fields.
            rootpxe_json_assign_text "$document" protocol '.protocol' || return 1
            rootpxe_json_assign_text "$document" storage_server '.storageip' || return 1
            rootpxe_json_assign_text "$document" storage_export '.exportPath' || return 1
            rootpxe_json_assign_text "$document" smb_username '.smbUsername' || return 1
            rootpxe_json_assign_text "$document" smb_password '.smbPassword' || return 1
            rootpxe_json_assign_text "$document" smb_domain '.smbDomain' || return 1
            ;;
        nfs)
            # NFS remains compatible with its existing nested and alias forms.
            rootpxe_json_assign_text "$document" storage_server '((.storage? | if type == "object" then .server else empty end) // .storageServer // .storage_server // .storageip)' || return 1
            rootpxe_json_assign_text "$document" storage_export '((.storage? | if type == "object" then .export else empty end) // .storageExport // .storage_export // .exportPath)' || return 1
            ;;
        *) return 1 ;;
    esac
    rootpxe_storage_apply_context "$document" || return 1
    rootpxe_storage_only=$(jq -r 'if .storageOnly == true and .storageAccess.storageOnly == true then "yes" else "no" end' <<<"$document") || return 1
    if [[ $rootpxe_storage_only == yes ]]; then
        rootpxe_validate_json_storage || return 1
        export taskid execution_token taskType pxe_type img protocol storage_server storage_export rootpxe_storage_only progress_attempt
        return 0
    fi
    rootpxe_json_assign_text "$document" hostName '.hostName // .host_name' || return 1
    rootpxe_json_assign "$document" changeHostname 'if has("changeHostname") then .changeHostname elif has("change_hostname") then .change_hostname else empty end' || return 1
    rootpxe_json_assign_text "$document" resumeStage '.resumeStage // .resume_stage' || return 1
    rootpxe_json_assign "$document" schemaRevision '.schemaRevision // .schema_revision' || return 1
    rootpxe_json_assign_text "$document" schemaHash '.schemaHash // .schema_hash' || return 1
    rootpxe_apply_json_deployment_identity_policy "$document" || return 1
    if [[ ${osid:-} == 50 && ${changeHostname:-false} == true ]] && ! rootpxe_cloud_init_policy_enabled; then
        rootpxe_linux_hostname_task_valid || return 1
    fi
    rootpxe_apply_json_partition_inventory "$document" || return 1
    rootpxe_multicast_apply_transport_mode "$document" || return 1
    rootpxe_validate_json_storage || return 1
    # Layout/schema are untrusted JSON data. Store canonical form in 0600 files;
    # they are never printed or made kernel arguments.
    umask 077
    if jq -e '.deploymentLayout != null' >/dev/null 2>&1 <<<"$document"; then
        deploymentLayoutFile=$(mktemp /tmp/rootpxe-layout.XXXXXX) || return 1
        jq -cS '.deploymentLayout' <<<"$document" >"$deploymentLayoutFile" || return 1
        chmod 600 "$deploymentLayoutFile"
    fi
    if jq -e '.originalSchema != null' >/dev/null 2>&1 <<<"$document"; then
        originalSchemaFile=$(mktemp /tmp/rootpxe-schema.XXXXXX) || return 1
        jq -cS '.originalSchema' <<<"$document" >"$originalSchemaFile" || return 1
        chmod 600 "$originalSchemaFile"
    fi
    rootpxe_apply_json_cloud_init "$document" || return 1
    export taskid execution_token taskType pxe_type img img_type img_partition_type osid img_format pigz_comp shutdown protocol storage_server storage_export hostName changeHostname resumeStage schemaRevision schemaHash deploymentLayoutFile originalSchemaFile partitionInventoryFile partitionInventoryHash deploymentIdentityPolicyFile multicastTransportMode multicastSessionId multicastSessionKey multicastWaitTimeoutSec mc
}

checkin_rootpxe() {
    # 私有 Cloud-init 只接受已认证 JSON，旧文本响应不可继承。
    rootpxe_cloud_init_cleanup_private || return 1
    rootpxe_console_message INFO 'Checking in with RootPXE.'
    rootpxe_require_identity || handleError "RootPXE: invalid task identity ($0)"
    rootpxe_multicast_reset
    local sysuuid_local
    sysuuid_local=$(dmidecode -s system-uuid 2>/dev/null || true)
    sysuuid_local=${sysuuid_local,,}
    local lmac
    # 按约定：使用服务端下发的任务主机 MAC（kernel cmdline 的 mac），不要在此处探测真实网卡
    lmac="$mac"
    local out checkin_payload_file
    local body
    local http_code
    local waitFlag=""
    local waitMsg=""
    local retryAfterSec=5
    local -a checkin_tls_args=(-ks)
    # 解析可能已生成私有任务文件，入口立即安装清理；信号必须停止任务。
    trap rootpxe_cleanup_session EXIT
    trap 'rootpxe_cleanup_session; exit 130' INT
    trap 'rootpxe_cleanup_session; exit 143' TERM
    if [[ ${manual_direct_task:-} == yes ]]; then
        [[ ${manual_spki_pin:-} =~ ^sha256//[A-Za-z0-9+/]{43}=$ ]] || return 1
        # The direct handoff token was received over the manual flow's pinned
        # HTTPS connection. Do not send it to an HTTP endpoint or a redirect.
        [[ ${rootpxe_api:-} == https://* ]] || return 1
        checkin_tls_args=(-ks --proto '=https' --proto-redir '=https' --max-redirs 0 --pinnedpubkey "$manual_spki_pin")
    fi
    while true; do
        waitFlag=""
        waitMsg=""
        retryAfterSec=5
        # Do not use curl -f here. A 4xx means the administrator withdrew the
        # task before checkin completed; it is a safe reboot, not a PXEOS error.
		umask 077
		checkin_payload_file=$(mktemp /tmp/rootpxe-checkin-request.XXXXXX) || handleError "RootPXE checkin context is invalid ($0)"
		chmod 600 "$checkin_payload_file" || { rm -f -- "$checkin_payload_file"; handleError "RootPXE checkin context is invalid ($0)"; }
		if ! rootpxe_write_checkin_json_payload "$checkin_payload_file"; then
			rm -f -- "$checkin_payload_file"
			handleError "RootPXE checkin context is invalid ($0)"
		fi
        out=$(rootpxe_task_curl "${checkin_tls_args[@]}" \
            --connect-timeout 10 --max-time 30 \
            -H 'Content-Type: application/json' \
			--data-binary "@$checkin_payload_file" \
            -w $'\n%{http_code}' "${rootpxe_api}checkin" 2>/dev/null)
        curl_status=$?
		rm -f -- "$checkin_payload_file"
        if [[ $curl_status -ne 0 ]]; then
            rootpxe_console_message WARN 'Check-in not confirmed. Retrying in 5s.'
            rootpxe_console_message INFO 'SSH is available for troubleshooting.'
            sleep 5
            continue
        fi
        http_code=${out##*$'\n'}
        body=${out%$'\n'*}
        if [[ $http_code =~ ^4[0-9][0-9]$ ]]; then
            # The task may have been aborted after the kernel started but
            # before checkin.  No task callback is allowed after this point.
            rootpxe_console_message INFO 'Task aborted or withdrawn. Stopping PXEOS.'
            printf '%s\n' reboot > /tmp/pxeos.failure_action
            return 2
        fi
        # A 5xx, malformed status, or empty 2xx response is uncertain. Keep
        # SSH available and retry checkin; never mount storage or start imaging.
        if [[ ! $http_code =~ ^2[0-9][0-9]$ || -z $body ]]; then
            rootpxe_console_message WARN 'Check-in not confirmed. Retrying in 5s.'
            rootpxe_console_message INFO 'SSH is available for troubleshooting.'
            sleep 5
            continue
        fi
        out=$body
        [[ $out == \{* ]] || { handleError "RootPXE checkin requires a JSON response ($0)"; return 1; }
        rootpxe_apply_json_checkin "$out" || handleError "RootPXE checkin returned invalid JSON ($0)"
        if [[ $waitFlag == "1" ]]; then
            [[ -z $waitMsg ]] && waitMsg="No open slots on server, waiting for queue"
            rootpxe_console_message INFO "$waitMsg"
            rootpxe_console_message INFO "Retrying in ${retryAfterSec}s."
            sleep "$retryAfterSec"
            debugPause
            continue
        fi
        break
    done
    # 将 checkin 下发的 shutdown（0/1）落盘，供 init 脚本在任务结束时读取。
    # 注意：S99pxeos 与 /bin/pxeos 不在同一进程环境，直接 export 无法回传变量。
    if [[ -n ${shutdown:-} ]]; then
        case "${shutdown}" in
            1) echo -n "1" > /tmp/pxeos.shutdown 2>/dev/null || true ;;
            *) echo -n "0" > /tmp/pxeos.shutdown 2>/dev/null || true ;;
        esac
    else
        # 未下发时默认重启
        echo -n "0" > /tmp/pxeos.shutdown 2>/dev/null || true
    fi
    task_token=${execution_token:-${task_token:-}}; export task_token
    rootpxe_require_task_context || handleError "RootPXE: missing execution token ($0)"
    if [[ ${rootpxe_storage_only:-no} == yes ]]; then
        type=$pxe_type; pxeType=$type
        [[ $taskType == capture || $taskType == deploy ]] && [[ $type == up || $type == down ]] || return 1
        rootpxe_prepare_smb_credentials || return 1
        export type pxeType taskType rootpxe_storage_only
        # S99pxeos must not replay the old finishAction after storage recovery.
        (umask 077; : >/tmp/pxeos.storage-recovery-only) || return 1
        return 0
    fi
    [[ -z ${osid:-} || $osid =~ ^[0-9]+$ ]] || handleError "Invalid OS id ($0)"
    [[ ${img_format:-} =~ ^[0-6]$ ]] || handleError "Invalid image format ($0)"
    [[ -z ${pigz_comp:-} ]] || rootpxe_validate_pigz_compression "$pigz_comp" "${img_format:-${imgFormat:-}}" || handleError "Invalid compression value ($0)"
    [[ -z ${reply_mac:-} || $(rootpxe_normalize_mac "$reply_mac") == "$macWinSafe" ]] || handleError "Checkin MAC mismatch ($0)"
    taskType=${taskType:-${type:-}}; type=${pxe_type:-${type:-}}; pxeType=$type
    [[ $type == up || $type == down ]] || handleError "Invalid PXEOS direction ($0)"
    case $taskType in deploy|capture) ;; *) handleError "Invalid task type ($0)";; esac
    imgType=${img_type:-${imgType:-}}; imgPartitionType=${img_partition_type:-${imgPartitionType:-}}
    imgFormat=${img_format:-${imgFormat:-}}; PIGZ_COMP=${pigz_comp:-${PIGZ_COMP:-}}; hostName=${hostName:-${host_name:-}}
    [[ -z ${changeHostname:-} || ${changeHostname:-} == true || ${changeHostname:-} == false ]] || handleError "Invalid changeHostname ($0)"
    if [[ ${osid:-} == 50 && ${changeHostname:-false} == true ]] && ! rootpxe_cloud_init_policy_enabled; then
        rootpxe_linux_hostname_task_valid || { handleError 'PXEOS_STAGE=checkin CODE=LINUX_HOSTNAME_POLICY_INVALID'; return 1; }
    fi
    export taskType type pxeType imgType imgPartitionType imgFormat PIGZ_COMP hostName changeHostname progress_attempt rootpxe_partition_progress_enabled resumeStage schemaRevision schemaHash partitionInventoryFile partitionInventoryHash deploymentIdentityPolicyFile
    protocol=${protocol,,}
    [[ $protocol == nfs || $protocol == smb ]] || handleError "Invalid storage protocol ($0)"
    storage_server=${storage_server:-$storageip}
    [[ -n $storage_server ]] || handleError "Invalid storage server ($0)"
    if [[ $protocol == smb ]]; then
        storage_export=$(rootpxe_validate_smb_export "${storage_export:-}") || handleError "Invalid SMB export path ($0)"
    else
        storage_export=${storage_export:-$export_path}
        rootpxe_validate_json_storage || handleError "Invalid NFS storage path ($0)"
    fi
    if ! rootpxe_prepare_smb_credentials; then
        handleError "RootPXE checkin returned invalid SMB credentials ($0)"
    fi
    rootpxe_console_message INFO "Storage protocol: ${protocol^^}"
    rootpxe_safe_relative_path "$img" >/dev/null || handleError "Invalid image path ($0)"
    rootpxe_report_disk_health_after_checkin
    rootpxe_console_message INFO 'Check-in completed.'
    debugPause
}

checkin_rootpxe
checkin_rc=$?
# This script is sourced by upload/download. A nonzero checkin result must
# terminate that parent task so S99pxeos can perform the fixed safe reboot.
[[ $checkin_rc -eq 0 ]] || exit "$checkin_rc"
[[ ${rootpxe_storage_only:-no} == yes ]] || rootpxe_stage checkin "PXEOS checkin completed"
[[ ${rootpxe_storage_only:-no} == yes ]] || pxeos_checkin_runtime_setup
