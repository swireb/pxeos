#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
clearScreen
displayBanner
disks=""
disk=""
hd=""
[[ -z $seconds ]] && seconds=60
getHardDisk
rootpxe_console_message WARN 'The following hard disk will be erased.'
rootpxe_console_message WARN "Target disk: $hd"
rootpxe_console_message WARN "Power off this computer within $seconds seconds to cancel."
usleep $((seconds * 1000000))

[[ $hd == *[Nn][Vv][Mm][Ee]* ]] && wipemode="nvme"

case $wipemode in
    nvme)
        rootpxe_console_message INFO "Starting NVMe format wipe for $hd."
        usleep 10000000
        nvme format $hd --force
        ;;
    full)
        rootpxe_console_message INFO "Starting full shred wipe for $hd."
        usleep 10000000
        shred -f -v -z -n 3 "$hd"
        ;;
    normal)
        rootpxe_console_message INFO "Starting normal shred wipe for $hd."
        usleep 10000000
        shred -f -v -n 1 "$hd"
        ;;
    fast|fastwipe)
        rootpxe_console_message INFO "Writing zeros to the start of $hd."
        dd if=/dev/zero of="$hd" bs=512 count=100000
        ;;
esac
rootpxe_console_message INFO 'Wiping complete.'
. /bin/pxeos.nonimgcomplete
