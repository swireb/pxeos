#!/bin/bash
# isdebug=yes only provides network addresses and SSH access instructions.
# Do not load task variables, mount storage, or scan disks in this script.
clear >/dev/null 2>&1 || :
cat <<'EOF'
+------------------------------------------------------------------------------+
|                                PXEOS Runtime                                 |
+------------------------------------------------------------------------------+
EOF

pxeos_debug_message() {
    local level="$1" message="$2" line chunk
    case $level in
        INFO|WARN|ERROR) ;;
        *) return 1 ;;
    esac
    while IFS= read -r line || [[ -n $line ]]; do
        while (( ${#line} > 72 )); do
            chunk=${line:0:72}
            printf '%-7s %s\n' "[$level]" "$chunk"
            line=${line:72}
        done
        printf '%-7s %s\n' "[$level]" "$line"
    done <<<"$message"
}

pxeos_debug_message INFO 'Mode: SSH debug.'
pxeos_debug_message INFO 'Task execution: skipped.'
pxeos_debug_message INFO 'Storage mounting: skipped.'
pxeos_debug_message INFO 'Disk discovery: skipped.'
pxeos_debug_message INFO 'Use SSH to run the PXEOS script you need to debug.'

addresses=$(/sbin/ip -o -4 addr show scope global 2>/dev/null | awk '{
    iface=$2
    cidr=$4
    sub(/\/.*$/, "", cidr)
    if (iface != "lo" && cidr != "") {
        printf "%s %s %s\n", iface, $4, cidr
    }
}')

if [[ -n $addresses ]]; then
    pxeos_debug_message INFO 'Global IPv4 addresses available for SSH:'
    while read -r iface cidr address; do
        [[ -z $iface || -z $cidr || -z $address ]] && continue
        pxeos_debug_message INFO "Interface: $iface ($cidr)."
        pxeos_debug_message INFO "SSH command: ssh root@$address"
    done <<<"$addresses"
else
    pxeos_debug_message WARN 'No global IPv4 address is available for SSH.'
    pxeos_debug_message INFO 'Check network configuration, DHCP status, and cable connectivity.'
fi

exit 0
