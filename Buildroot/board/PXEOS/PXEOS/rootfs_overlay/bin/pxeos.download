#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
. /bin/pxeos.checkin
rootpxe_download_cleanup_initialization_private() {
    rootpxe_deployment_identity_cleanup_private
}
# The private initialization payload remains needed through finish reporting,
# then must be removed on both normal completion and every task exit/signal.
trap rootpxe_download_cleanup_initialization_private EXIT
trap 'rootpxe_download_cleanup_initialization_private; exit 143' INT TERM
rootpxe_partition_progress_initialize_runtime
. /bin/pxeos.mount
. /bin/pxeos.checkmount
. /bin/pxeos.checkimgvar
rootpxe_validate_image_contract || handleError "PXEOS_STAGE=layout_validation CODE=IMAGE_CONTRACT_INVALID REASON=unsupported_type_scope_or_capture_format"
hd=""
disks=""
disk=""
parts=""
part=""
imagePath=$(rootpxe_storage_path "${img:-}") || handleError "Invalid image path ($0)"
rootpxe_validate_fixed_image_lvm_inventory "$imagePath" || handleError "PXEOS_STAGE=layout_validation CODE=FIXED_IMAGE_LVM_INVENTORY_INVALID REASON=missing_or_lvm_raw_inventory"
origmac=$mac
mac=$(getMACAddresses | base64)
. /bin/pxeos.inventory "true"
mac="$origmac"
origmac=""
layPartSize="-1s"
progress_mode=partclone
if [[ ${imgLegacy:-${imgFormat:-}} == 1 ]]; then
    progress_mode=partimage
    # Partimage has no Partclone decoder generation.  Keep a stable generation
    # so the partition reporter can bind its legacy status samples to this run.
    rootpxe_partclone_progress_run_id=partimage-legacy
    rootpxe_partclone_progress_generation=0
else
    rootpxe_partclone_progress_initialize || handleError "PXEOS_STAGE=restore CODE=RESTORE_PROGRESS_SETUP_FAILED REASON=unable_to_initialize_partclone_progress"
fi
pxeos.statusreporter "$mac" "${pxeapi:-$web}" "$taskid" "$rootpxe_partclone_progress_run_id" "$progress_mode" & disown
statusReporter="$!"
fixed_size_partitions=""
rootpxe_console_message INFO "Using image: $img."
preparePartitions() {
    rootpxe_console_message INFO 'Preparing partition layout.'
    # n images now always use the validated layout snapshot below.  Do not
    # restore the captured table and then run the historical fill path first:
    # that performs a second, competing partition-table write before the final
    # target-specific table is applied.
    if [[ ${imgType:-} == [Nn] ]]; then
        rootpxe_console_message INFO 'Using validated single-disk deployment layout.'
        return 0
    fi
    case $imgType in
        mps)
            [[ ! -d $imagePath ]] && handleError "Unable to locate image store ($0)\n   Args Passed: $*"
            restorePartitionTablesAndBootLoaders "$hd" 1 "$imagePath" "$osid" "$imgPartitionType"
            runPartprobe "$hd"
            gptcheck="$global_gptcheck"
            ;;
        mpa)
            [[ ! -d $imagePath ]] && handleError "Unable to locate image store ($0)\n   Args Passed: $*"
            disk_number=1
            for disk in $disks; do
                if [[ ${rootpxe_mpa_permit_is_batch:-no} == yes ]]; then
                    rootpxe_activate_disk_permit_binding "$disk" deploy_write || handleError "PXEOS_STAGE=prepare_partitions CODE=DISK_PERMIT_BINDING_CHANGED REASON=target_disk_identity_or_operation_mismatch"
                fi
                restorePartitionTablesAndBootLoaders "$disk" "$disk_number" "$imagePath" "$osid" "$imgPartitionType"
                runPartprobe "$disk"
                gptcheck="$global_gptcheck"
                let disk_number+=1
            done
            ;;
    esac
}
putDataBack() {
    runPartprobe "$hd"
    getPartitions "$hd"
    [[ -z $parts ]] && rootpxe_console_message WARN 'Restoring to an empty disk may cause problems.'
    rootpxe_console_message INFO 'Attempting image deployment.'
    [[ $imgFormat -eq 1 || $imgLegacy -eq 1 ]] \
        && rootpxe_console_message INFO 'Image format: Partimage.' \
        || rootpxe_console_message INFO 'Image format: Partclone.'
    [[ $mc == yes ]] && usleep 10000000 || usleep 3000000
    case $imgType in
        dd)
            restorePartition "$hd" 1 "$imagePath/${img}*" "$mc"
            ;;
        n|mps|mpa)
            [[ $imgType == +(n|mps) ]] && disks="$hd"
            case $osid in
                [1-2])
                    [[ ! -f $imagePath && ! -d $imagePath ]] && handleError "Fatal Error: Could not locate file ($0)\n   Args Passed: $*"
                    ;;
                [5-7]|9|10|11)
                    [[ ! -d $imagePath && ! -f $imagePath/sys.img.000 ]] && handleError "Fatal Error: Could not locate file ($0)\n   Args Passed: $*"
                    ;;
                4|50|51)
                    [[ ! -d $imagePath ]] && handleError "Fatal Error: could not locate file ($0)\n   Args Passed: $*"
                    ;;
            esac
            performRestore "$disks" "$imagePath" "$imgPartitionType" "$mc"
            ;;
    esac
}
findHDDInfo
sector_metadata="$imagePath/d1.partitions"
if [[ ${resumeStage:-} == customizing_hostname || ${resumeStage:-} == post_deploy_script ]]; then
    # A retry after disk writes only replays the existing deploy-write permit
    # for the same stable disk, then continues hostname customization or the
    # post-deploy script without restoring partitions again.
    # It must not plan NVMe formatting, validate/apply a new layout, or rerun
    # any pre-write step before the safe resume point.
    if [[ ${imgType:-} == mpa ]]; then
        [[ -z ${rootpxe_disk_permit_disk_map_file:-} ]] || rm -f -- "$rootpxe_disk_permit_disk_map_file"
        unset rootpxe_disk_permit_disk_map_file
        rootpxe_clear_disk_permit
        rootpxe_mpa_permit_args=()
        for disk in $disks; do
            resume_target_id=$(rootpxe_disk_stable_identity "$disk") || handleError "PXEOS_STAGE=${resumeStage} CODE=RESUME_TARGET_IDENTITY_UNAVAILABLE"
            rootpxe_record_disk_permit_binding "$disk" "$resume_target_id" deploy_write || handleError "PXEOS_STAGE=${resumeStage} CODE=RESUME_TARGET_BINDING_INVALID"
            rootpxe_mpa_permit_args+=("$resume_target_id" deploy_write)
        done
        [[ ${#rootpxe_mpa_permit_args[@]} -gt 0 ]] || handleError "PXEOS_STAGE=${resumeStage} CODE=RESUME_TARGET_IDENTITY_UNAVAILABLE"
        (( ${#rootpxe_mpa_permit_args[@]} > 2 )) && rootpxe_mpa_permit_is_batch=yes || rootpxe_mpa_permit_is_batch=no
    else
        resume_target_id=$(rootpxe_disk_stable_identity "$hd") || handleError "PXEOS_STAGE=${resumeStage} CODE=RESUME_TARGET_IDENTITY_UNAVAILABLE"
        rootpxe_mpa_permit_is_batch=no
    fi
    while :; do
        if [[ ${rootpxe_mpa_permit_is_batch:-no} == yes ]]; then
            rootpxe_wait_for_disk_permit_batch "${rootpxe_mpa_permit_args[@]}"
        else
            rootpxe_wait_for_disk_permit "$resume_target_id" deploy_write
        fi && {
            permit_result=0
        } || {
            permit_result=$?
        }
        case $permit_result in
            0) break ;;
            10)
                rootpxe_console_message INFO 'Task aborted or deleted. Stopping PXEOS.'
                printf '%s\n' reboot > /tmp/pxeos.failure_action
                exit 2
                ;;
            20) exit 2 ;;
            *)
                rootpxe_console_message WARN 'Disk permit wait was interrupted. Retrying in 5s.'
                sleep 5
                ;;
        esac
    done
    if [[ ${imgType:-} == mpa && ${rootpxe_mpa_permit_is_batch:-no} == yes ]]; then
        for disk in $disks; do
            rootpxe_verify_disk_permit_binding "$disk" deploy_write || handleError "PXEOS_STAGE=${resumeStage} CODE=RESUME_TARGET_BINDING_CHANGED"
        done
        rootpxe_activate_disk_permit_binding "$hd" deploy_write || handleError "PXEOS_STAGE=${resumeStage} CODE=RESUME_TARGET_BINDING_CHANGED"
    fi
    if rootpxe_deployment_identity_policy_enabled; then
        # Both safe resume points need a result bound to the current attempt.
        # The post-deploy resume can follow an interruption before the prior
        # result POST, so only reloading the plan would make imgcomplete fail
        # its server-side result gate. Reapply the frozen, idempotent settings
        # under the existing deploy permit and submit a fresh result.
        if [[ ${imgType:-} == mpa ]]; then
            rootpxe_deployment_identity_request_plan $disks || handleError "PXEOS_STAGE=deployment_identity_plan CODE=IDENTITY_PLAN_REJECTED"
        else
            rootpxe_deployment_identity_request_plan "$hd" || handleError "PXEOS_STAGE=deployment_identity_plan CODE=IDENTITY_PLAN_REJECTED"
        fi
        if rootpxe_deployment_identity_private_enabled; then
            rootpxe_deployment_identity_request_private || handleError "PXEOS_STAGE=system_initialization CODE=INITIALIZATION_PRIVATE_CONFIG_UNAVAILABLE"
        fi
        if rootpxe_deployment_identity_storage_enabled; then
            # Storage randomization changes references outside the raw disk
            # identifiers (Windows BCD/MountedDevices/EFI and Linux boot
            # references). A safe resume cannot prove every repair completed,
            # so require a fresh deployment instead of rewriting identifiers
            # or manufacturing a successful result for this attempt.
            handleError "PXEOS_STAGE=deployment_identity_resume CODE=STORAGE_IDENTITY_RESUME_REQUIRES_REDEPLOY"
        fi
        if [[ ${resumeStage:-} == customizing_hostname ]] && [[ ${changeHostname:-false} != true ]] && ! rootpxe_deployment_identity_linux_policy_enabled && ! { rootpxe_deployment_identity_windows_policy_enabled && jq -e '.systemIdentity.sysprep == true' "$deploymentIdentityPolicyFile" >/dev/null 2>&1; }; then
            handleError "PXEOS_STAGE=customizing_hostname CODE=RESUME_CONTRACT_INVALID REASON=system_initialization_not_enabled"
        fi
        rootpxe_stage customizing_hostname "resume permit confirmed"
        if [[ ${changeHostname:-false} == true ]] || rootpxe_deployment_identity_linux_policy_enabled || { rootpxe_deployment_identity_windows_policy_enabled && jq -e '.systemIdentity.sysprep == true' "$deploymentIdentityPolicyFile" >/dev/null 2>&1; }; then
            rootpxe_apply_hostname_for_disk "$hd" || handleError "PXEOS_STAGE=system_initialization CODE=SYSTEM_INITIALIZATION_FAILED"
        fi

        rootpxe_deployment_identity_report_result "${rootpxe_deployment_identity_storage_result:-false}" "${rootpxe_deployment_identity_hostname_result:-false}" "${rootpxe_deployment_identity_machine_id_result:-false}" "${rootpxe_deployment_identity_ssh_host_keys_result:-false}" "${rootpxe_deployment_identity_ssh_login_public_keys_result:-false}" "${rootpxe_deployment_identity_root_password_result:-false}" "${rootpxe_deployment_identity_sysprep_result:-false}" || handleError "PXEOS_STAGE=deployment_identity_result CODE=IDENTITY_RESULT_REJECTED"
        rootpxe_deployment_identity_cleanup_private
    elif [[ ${resumeStage:-} == customizing_hostname && ${changeHostname:-false} == true ]]; then
        # Hostname-only tasks do not require the extended identity plan or
        # private payload, but their safe resume point still has to apply the frozen
        # task hostname before moving on to the post-deploy stage.
        rootpxe_stage customizing_hostname "resume permit confirmed"
        rootpxe_apply_hostname_for_disk "$hd" || handleError "PXEOS_STAGE=customizing_hostname CODE=HOSTNAME_FAILED"
    fi
    rootpxe_run_post_deploy_script || handleError "PXEOS_STAGE=post_deploy_script CODE=POST_DEPLOY_SCRIPT_FAILED REASON=${rootpxe_deploy_script_error:-unknown}"
    . /bin/pxeos.imgcomplete
    exit 0
fi
if [[ ${imgType:-} == [Nn] ]]; then
    rootpxe_require_single_disk_layout_metadata "$sector_metadata" "${originalSchemaFile:-}" "${deploymentLayoutFile:-}" || handleError "PXEOS_STAGE=layout_validation CODE=N_LAYOUT_METADATA_MISSING REASON=${rootpxe_layout_metadata_reason:-unknown}"
rootpxe_validate_deployment_layout "$hd" "$originalSchemaFile" "$deploymentLayoutFile" || handleError "PXEOS_STAGE=layout_validation CODE=INVALID_DEPLOYMENT_LAYOUT REASON=pre_permit_validation_failed"
rootpxe_validate_growth_capability "$originalSchemaFile" "$rootpxe_resolved_layout_file" || handleError "PXEOS_STAGE=layout_validation CODE=UNSUPPORTED_FILESYSTEM_GROWTH REASON=validated_layout_requires_unsupported_growth"
fi
rootpxe_validate_restore_artifacts "$imagePath" "$imgType" "$imgPartitionType" "${originalSchemaFile:-}" || handleError "PXEOS_STAGE=restore_preflight CODE=REQUIRED_ARTIFACT_MISSING REASON=target_write_not_started"
if [[ ${imgType:-} == mpa ]]; then
    rootpxe_plan_mpa_disk_permits "$imagePath" || handleError "PXEOS_STAGE=permit CODE=MPA_TARGET_MAPPING_INVALID REASON=unable_to_bind_complete_target_disk_set"
else
    rootpxe_plan_deploy_disk_operation "$hd" "$sector_metadata" || handleError "PXEOS_STAGE=permit CODE=TARGET_IDENTITY_UNAVAILABLE REASON=unable_to_bind_target_disk"
    rootpxe_mpa_permit_is_batch=no
fi
while :; do
    if [[ ${rootpxe_mpa_permit_is_batch:-no} == yes ]]; then
        rootpxe_wait_for_disk_permit_batch "${rootpxe_mpa_permit_args[@]}"
    else
        rootpxe_wait_for_disk_permit "$rootpxe_planned_target_id" "$rootpxe_planned_disk_operation"
    fi && {
        permit_result=0
    } || {
        permit_result=$?
    }
    case $permit_result in
        0) break ;;
        10)
            rootpxe_console_message INFO 'Task aborted or deleted. Stopping PXEOS.'
            printf '%s\n' reboot > /tmp/pxeos.failure_action
            exit 2
            ;;
        20) exit 2 ;;
        *)
            rootpxe_console_message WARN 'Disk permit wait was interrupted. Retrying in 5s.'
            sleep 5
            ;;
    esac
done
if [[ ${imgType:-} == mpa && ${rootpxe_mpa_permit_is_batch:-no} == yes ]]; then
    for disk in $disks; do
        rootpxe_verify_disk_permit_binding "$disk" deploy_write || handleError "PXEOS_STAGE=permit CODE=DISK_PERMIT_BINDING_CHANGED REASON=target_disk_identity_or_operation_mismatch"
    done
fi
# Freeze the identity plan only after every target has an active permit, but
# before a deployment script, partition table, NVMe format or payload writer
# can change the target. Storage plans use the frozen single-disk schema or
# frozen multi-disk inventory, never a target table read at deployment time.
if rootpxe_deployment_identity_policy_enabled; then
    if [[ ${imgType:-} == mpa ]]; then
        rootpxe_deployment_identity_request_plan $disks
    else
        rootpxe_deployment_identity_request_plan "$hd"
    fi || handleError "PXEOS_STAGE=deployment_identity_plan CODE=IDENTITY_PLAN_FAILED REASON=source_metadata_or_permit_binding_invalid"
fi
rootpxe_run_pre_deploy_script || handleError "PXEOS_STAGE=pre_deploy_script CODE=PRE_DEPLOY_SCRIPT_FAILED REASON=${rootpxe_deploy_script_error:-unknown}"
rootpxe_stage init "pxeos download started, storage mounted"
[[ $nombr -eq 1 ]] && rootpxe_console_message INFO 'Skipping partition layout: single-partition restore.' || preparePartitions
if [[ ${imgType:-} == [Nn] ]]; then
    # NVMe reformat may have changed logical geometry; resolve once more before
    # the final sfdisk write and verify the table after applying it.
    rootpxe_validate_deployment_layout "$hd" "$originalSchemaFile" "$deploymentLayoutFile" || handleError "PXEOS_STAGE=layout_validation CODE=INVALID_DEPLOYMENT_LAYOUT REASON=post_format_validation_failed"
    if ! rootpxe_apply_deployment_layout "$hd" "$sector_metadata"; then
        handleError "PXEOS_STAGE=layout_apply CODE=${rootpxe_layout_apply_code:-LAYOUT_APPLY_FAILED} REASON=${rootpxe_layout_apply_reason:-unknown}${rootpxe_layout_diagnostics_file:+ DIAGNOSTICS=${rootpxe_layout_diagnostics_file}}"
    fi
    rootpxe_restore_deployment_boot_code "$hd" 1 "$imagePath" "$originalSchemaFile" || handleError "PXEOS_STAGE=layout_apply CODE=BOOT_CODE_RESTORE_FAILED REASON=boot_code_metadata_invalid"
fi
[[ $nombr -ne 1 ]] && rootpxe_stage prepare_partitions "partition layout prepared"
# Build one immutable, full plan only after the permitted target layout exists.
# Raw dd remains a single disk item because it has no safe internal boundaries.
case ${imgType:-} in
    dd) rootpxe_partition_progress_plan_whole_disk "$hd" 1 ;;
    mpa) rootpxe_partition_progress_plan_disks $disks ;;
    n|mps) rootpxe_partition_progress_plan_disk "$hd" 1 ;;
esac
if [[ $imgPartitionType != mbr ]]; then
    # LVM PVs have no raw dNpN payload.  Restore ordinary image partitions
    # first when present, then reconstruct the permitted LVM metadata/LVs.
    if [[ -z ${rootpxe_resolved_lvm_layout_file:-} ]] || jq -e '.partitions[] | select(.role != "lvm_pv" and .artifact != "")' "$originalSchemaFile" >/dev/null 2>&1; then
        putDataBack
    fi
    if [[ -n ${rootpxe_resolved_lvm_layout_file:-} ]]; then
        rootpxe_restore_lvm_volumes "$imagePath" "$hd" || handleError "PXEOS_STAGE=restore_lvm CODE=${rootpxe_restore_lvm_error_code:-LVM_RESTORE_FAILED} REASON=${rootpxe_restore_lvm_error_reason:-unknown}"
    fi
else
    rootpxe_console_message INFO 'Skipping partition restore: MBR only.'
fi
completeTasking
