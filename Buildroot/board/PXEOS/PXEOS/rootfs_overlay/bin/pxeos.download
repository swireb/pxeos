#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
. /bin/pxeos.checkin
. /bin/pxeos.mount
. /bin/pxeos.checkmount
. /bin/pxeos.checkimgvar
hd=""
disks=""
disk=""
parts=""
part=""
imagePath=$(rootpxe_storage_path "${img:-}") || handleError "Invalid image path ($0)"
origmac=$mac
mac=$(getMACAddresses | base64)
. /bin/pxeos.inventory "true"
mac="$origmac"
origmac=""
layPartSize="-1s"
pxeos.statusreporter "$mac" "${pxeapi:-$web}" "$taskid" & disown
statusReporter="$!"
fixed_size_partitions=""
rootpxe_console_message INFO "Using Image: $img"
preparePartitions() {
    rootpxe_console_message INFO 'Preparing Partition layout'
    # n images now always use the validated layout snapshot below.  Do not
    # restore the captured table and then run the historical fill path first:
    # that performs a second, competing partition-table write before the final
    # target-specific table is applied.
    if [[ ${imgType:-} == [Nn] ]]; then
        rootpxe_console_message INFO 'Using validated single-disk deployment layout'
        return 0
    fi
    case $imgType in
        mps)
            [[ ! -d $imagePath ]] && handleError "Unable to locate image store ($0)\n   Args Passed: $*"
            restorePartitionTablesAndBootLoaders "$hd" 1 "$imagePath" "$osid" "$imgPartitionType"
            runPartprobe "$hd"
            gptcheck="$global_gptcheck"
            ;;
        mpa)
            [[ ! -d $imagePath ]] && handleError "Unable to locate image store ($0)\n   Args Passed: $*"
            disk_number=1
            for disk in $disks; do
                restorePartitionTablesAndBootLoaders "$disk" "$disk_number" "$imagePath" "$osid" "$imgPartitionType"
                runPartprobe "$disk"
                gptcheck="$global_gptcheck"
                let disk_number+=1
            done
            ;;
    esac
}
putDataBack() {
    runPartprobe "$hd"
    getPartitions "$hd"
    [[ -z $parts ]] && echo -e " * Seems like you are trying to restore to an empty disk. Be aware this will most probably cause trouble.\n"
    echo "   +--------------------------------+"
    echo "   |   Attempting to deploy image   |"
    echo "   +--------------------------------+"
    [[ $imgFormat -eq 1 || $imgLegacy -eq 1 ]] && echo "   |         Using Partimage        |" || echo "   |         Using Partclone        |"
    echo "   +--------------------------------+"
    [[ $mc == yes ]] && usleep 10000000 || usleep 3000000
    case $imgType in
        dd)
            restorePartition "$hd" 1 "$imagePath/${img}*" "$mc"
            ;;
        n|mps|mpa)
            [[ $imgType == +(n|mps) ]] && disks="$hd"
            case $osid in
                [1-2])
                    [[ ! -f $imagePath && ! -d $imagePath ]] && handleError "Fatal Error: Could not locate file ($0)\n   Args Passed: $*"
                    ;;
                [5-7]|9|10|11)
                    [[ ! -d $imagePath && ! -f $imagePath/sys.img.000 ]] && handleError "Fatal Error: Could not locate file ($0)\n   Args Passed: $*"
                    ;;
                4|50|51)
                    [[ ! -d $imagePath ]] && handleError "Fatal Error: could not locate file ($0)\n   Args Passed: $*"
                    ;;
            esac
            performRestore "$disks" "$imagePath" "$imgPartitionType" "$mc"
            ;;
    esac
}
findHDDInfo
sector_metadata="$imagePath/d1.partitions"
if [[ ${resumeStage:-} == customizing_hostname ]]; then
    # A retry after disk writes only replays the existing deploy-write permit
    # for the same stable disk, then customizes the deployed OS hostname and runs postdeploy.
    # It must not plan NVMe formatting, validate/apply a new layout, or rerun
    # postinit before the safe resume point.
    resume_target_id=$(rootpxe_disk_stable_identity "$hd") || handleError "PXEOS_STAGE=customizing_hostname CODE=RESUME_TARGET_IDENTITY_UNAVAILABLE"
    while :; do
        if rootpxe_wait_for_disk_permit "$resume_target_id" deploy_write; then
            permit_result=0
        else
            permit_result=$?
        fi
        case $permit_result in
            0) break ;;
            10)
                echo "[INFO]  Task aborted or deleted. Stopping PXEOS."
                printf '%s\n' reboot > /tmp/pxeos.failure_action
                exit 2
                ;;
            20) exit 2 ;;
            *)
                printf '%s\n' '[WARN]  Disk permit wait was interrupted. Retrying in 5s.'
                sleep 5
                ;;
        esac
    done
    [[ ${changeHostname:-false} == true ]] || handleError "PXEOS_STAGE=customizing_hostname CODE=RESUME_CONTRACT_INVALID REASON=hostname_change_not_enabled"
    rootpxe_stage customizing_hostname "resume permit confirmed"
    rootpxe_apply_hostname_for_disk "$hd"
    if [[ -f /storage/postdeployscripts/hook.sh ]]; then
        . /storage/postdeployscripts/hook.sh || handleError "Post-deploy script failed"
    fi
    . /bin/pxeos.imgcomplete
    exit 0
fi
if [[ ${imgType:-} == [Nn] ]]; then
    rootpxe_require_single_disk_layout_metadata "$sector_metadata" "${originalSchemaFile:-}" "${deploymentLayoutFile:-}" || handleError "PXEOS_STAGE=layout_validation CODE=N_LAYOUT_METADATA_MISSING REASON=${rootpxe_layout_metadata_reason:-unknown}"
    rootpxe_validate_deployment_layout "$hd" "$originalSchemaFile" "$deploymentLayoutFile" || handleError "PXEOS_STAGE=layout_validation CODE=INVALID_DEPLOYMENT_LAYOUT REASON=pre_permit_validation_failed"
fi
rootpxe_plan_deploy_disk_operation "$hd" "$sector_metadata" || handleError "PXEOS_STAGE=permit CODE=TARGET_IDENTITY_UNAVAILABLE REASON=unable_to_bind_target_disk"
while :; do
    if rootpxe_wait_for_disk_permit "$rootpxe_planned_target_id" "$rootpxe_planned_disk_operation"; then
        permit_result=0
    else
        permit_result=$?
    fi
    case $permit_result in
        0) break ;;
        10)
            echo "[INFO]  Task aborted or deleted. Stopping PXEOS."
            printf '%s\n' reboot > /tmp/pxeos.failure_action
            exit 2
            ;;
        20) exit 2 ;;
        *)
            printf '%s\n' '[WARN]  Disk permit wait was interrupted. Retrying in 5s.'
            sleep 5
            ;;
    esac
done
rootpxe_run_postinit || handleError "Post-init script failed ($0)"
rootpxe_stage init "pxeos download started, storage mounted"
[[ $nombr -eq 1 ]] && echo " * Skipping partition layout (Single Partition restore)" || preparePartitions
if [[ ${imgType:-} == [Nn] ]]; then
    # NVMe reformat may have changed logical geometry; resolve once more before
    # the final sfdisk write and verify the table after applying it.
    rootpxe_validate_deployment_layout "$hd" "$originalSchemaFile" "$deploymentLayoutFile" || handleError "PXEOS_STAGE=layout_validation CODE=INVALID_DEPLOYMENT_LAYOUT REASON=post_format_validation_failed"
    rootpxe_apply_deployment_layout "$hd" "$sector_metadata" || handleError "PXEOS_STAGE=layout_apply CODE=LAYOUT_READBACK_FAILED REASON=sfdisk_layout_mismatch"
    rootpxe_restore_deployment_boot_code "$hd" 1 "$imagePath" "$originalSchemaFile" || handleError "PXEOS_STAGE=layout_apply CODE=BOOT_CODE_RESTORE_FAILED REASON=boot_code_metadata_invalid"
fi
[[ $nombr -ne 1 ]] && rootpxe_stage prepare_partitions "partition layout prepared"
if [[ $imgPartitionType != mbr ]]; then
    # LVM PVs have no raw dNpN payload.  Restore ordinary image partitions
    # first when present, then reconstruct the permitted LVM metadata/LVs.
    if [[ -z ${rootpxe_resolved_lvm_layout_file:-} ]] || jq -e '.partitions[] | select(.role != "lvm_pv" and .artifact != "")' "$originalSchemaFile" >/dev/null 2>&1; then
        putDataBack
    fi
    if [[ -n ${rootpxe_resolved_lvm_layout_file:-} ]]; then
        rootpxe_restore_lvm_volumes "$imagePath" "$hd" || handleError "PXEOS_STAGE=restore_lvm CODE=LVM_RESTORE_FAILED REASON=metadata_or_lv_restore_failed"
    fi
else
    echo " * Skipping partition restore (MBR Only)"
fi
completeTasking
