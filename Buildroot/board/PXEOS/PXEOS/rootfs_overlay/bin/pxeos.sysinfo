#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
for arg in $(cat /proc/cmdline | tr -d \\0); do
    case $arg in
        initsh)
            ash -i
            ;;
    esac
done
clearScreen
displayBanner
mac=$(getMACAddresses)
oPS3=$PS3
PS3="[INFO]  Select an option: "
choices="Network Information\nPartition Information\nCheck PXEOS Compatibility\nPing a Host\nDisplay MAC Address\nShow DMI Information"
case $isdebug in
    [Yy][Ee][Ss]|[Yy])
        choices="Quit\n$choices"
        ;;
    *)
        choices="Reboot\n$choices"
        ;;
esac
oIFS=$IFS
IFS=$'\n'
choices=$(echo -e $choices)
wait_enter() {
    rootpxe_console_prompt INFO 'Press Enter to continue.'
    read -s tmp
}
while :; do
    select choice in $choices; do
        case $REPLY in
            1)
                case $isdebug in
                    [Yy][Ee][Ss]|[Yy])
                        exit 0
                        ;;
                    *)
                        reboot -f
                        ;;
                esac
                ;;
            2)
                clearScreen
                rootpxe_console_message INFO 'Network information:'
                ip addr 2>/dev/null
                rootpxe_console_message INFO 'DNS information:'
                cat /etc/resolv.conf 2>/dev/null
                wait_enter
                ;;
            3)
                clearScreen
                rootpxe_console_message INFO 'Partition information:'
                parted --list 2>/dev/null
                wait_enter
                ;;
            4)
                clearScreen
                rootpxe_console_message INFO 'PXEOS compatibility check:'
                tmpDisk=$(parted --list 2>/dev/null | grep "Disk")
                tmpNic=$(ip addr | grep "link/ether")
                [[ -n $tmpDisk ]] && blHddOk="Pass" || blHddOk="Fail"
                [[ -n $tmpNic ]] && blNicOk="Pass" || blNicOk="Fail"
                if [[ $blNicOk == Pass && $blHddOk == Pass ]]; then
                    rootpxe_console_message INFO 'Hardware compatibility checks passed.'
                else
                    rootpxe_console_message WARN 'Hardware compatibility checks failed.'
                fi
                rootpxe_console_message INFO 'Compatibility results:'
                rootpxe_console_message INFO "Network: $blNicOk."
                rootpxe_console_message INFO "Disk device: $blHddOk."
                if [[ $blNicOk == Fail || $blHddOk == Fail ]]; then
                    rootpxe_console_message WARN 'Try a newer PXEOS kernel if this device is unsupported.'
                    rootpxe_console_message INFO 'Collect the following data for PXEOS support.'
                    rootpxe_console_message INFO 'PCI Ethernet devices:'
                    lspci -nn | grep Ethernet
                    rootpxe_console_message INFO 'Block devices:'
                    lsblk
                fi
                wait_enter
                ;;
            5)
                clearScreen
                rootpxe_console_message INFO 'Ping a host:'
                regex='(https?|ftp|file)://[-A-Za-z0-9\+&@#/%?=~_|!:,.;]*[-A-Za-z0-9\+&@#/%=~_|]'
                while [[ -z $phost ]]; do
                    rootpxe_console_prompt INFO 'Enter host to ping: '
                    read phost
                    phost=$(echo $phost)
                    if [[ -z $phost || $phost =~ $regex ]]; then
                        phost=""
                        rootpxe_console_message WARN 'Invalid entry. Please try again.'
                    fi
                done
                ping -c 4 $phost
                unset phost
                wait_enter
                ;;
            6)
                clearScreen
                rootpxe_console_message INFO "System MAC address: $mac"
                wait_enter
                ;;
            7)
                clearScreen
                test="bios-vendor bios-version bios-release-date system-manufacturer system-product-name system-version system-serial-number system-uuid baseboard-manufacturer baseboard-product-name baseboard-version baseboard-serial-number baseboard-asset-tag chassis-manufacturer chassis-type chassis-version chassis-serial-number chassis-asset-tag processor-family processor-manufacturer processor-version processor-frequency"
                i=0
                IFS=$oIFS
                for t in $test; do
                    v=$(dmidecode --string $t)
                    rootpxe_console_message INFO "DMI $t: $v"
                    let i+=1
                    if [[ $i == 5 ]]; then
                        rootpxe_console_prompt INFO 'Press Enter to proceed.'
                        read tmp
                        i=0
                    fi
                done
                IFS=$'\n'
                wait_enter
                ;;
            *)
                rootpxe_console_message WARN 'Invalid entry. Please try again.'
                wait_enter
                ;;
        esac
        break
    done
done
IFS=$oIFS
