#!/bin/bash
if [[ ${rootpxe_capture_direct:-no} == yes ]]; then
    mountpoint -q /storage || handleError "Capture storage is not mounted"
    return 0
fi
# Mount identity and version were verified by the restricted helper. Deployment
# uses local metadata copies; neither a read test nor a read task creates dev.
dots "Checking mounted file system"
[[ -n ${rootpxe_storage_workspace:-} && -f $rootpxe_storage_workspace/preflight.json ]] || handleError "PXEOS_STAGE=storage CODE=STORAGE_PREFLIGHT_REQUIRED"
if [[ ${type:-} == up ]]; then
    rootpxe_storage_prepare_capture || handleError "PXEOS_STAGE=storage CODE=STORAGE_WRITE_PREPARE_FAILED"
elif [[ ${type:-} == down ]]; then
    rootpxe_storage_load_shadow || handleError "PXEOS_STAGE=storage CODE=STORAGE_READ_PREPARE_FAILED"
else
    handleError "PXEOS_STAGE=storage CODE=STORAGE_TASK_TYPE_INVALID"
fi
echo "Done"
debugPause
