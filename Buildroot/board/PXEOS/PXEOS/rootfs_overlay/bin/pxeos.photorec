#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh
clearScreen
displayBanner
disks=""
disk=""
hd=""
parts=""
part=""
getHardDisk "true"
dots "Creating file system mount point"
[[ ! -d /storage ]] && mkdir -p /storage >/dev/null 2>&1
if [[ ! -d /storage ]]; then
    echo "Failed"
    debugPause
    handleError "Count not create image directory ($0)\n   Args Passed: $*"
fi
echo "Done"
debugPause
dots "Mounting file system"
mount -o nolock $storage /storage >/tmp/mount-output 2>&1
case $? in
    0)
        echo "Done"
        debugPause
        ;;
    *)
        echo "Failed"
        debugPause
        handleError "Could not mount $storage ($0)\n    Args Passed: $*\n     Reason: $(cat /tmp/mount-output | tr -d \\0)"
        ;;
esac
debugPause
for disk in $disks; do
rootpxe_console_message INFO "Starting PhotoRec on $disk."
    usleep 2000000
    getPartitions "$disk"
    for part in $parts; do
rootpxe_console_message INFO "Running PhotoRec on $part."
        photorec $part
    done
    usleep 5000000
done
. /bin/pxeos.nonimgcomplete
