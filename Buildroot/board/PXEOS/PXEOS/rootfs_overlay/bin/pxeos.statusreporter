#!/bin/bash
. /usr/share/pxeos/lib/partclone-progress.sh
sysuuid=$(dmidecode -s system-uuid)
sysuuid=${sysuuid,,}
oIFS=$IFS
IFS=$'\n'
mac="$1"
api_base="$2"
taskid="${3:-${taskid}}"
progress_run_id="${4:-}"
progress_mode="${5:-partclone}"
[[ -z $api_base ]] && api_base="${pxeapi:-$web}"
[[ -z $taskid ]] && exit 0
task_token="${task_token:-${execution_token:-}}"
[[ $taskid =~ ^[1-9][0-9]*$ && $mac =~ ^[0-9A-Fa-f:]{12,17}$ && $task_token =~ ^[A-Za-z0-9._~+/=-]{16,512}$ ]] || exit 0
case $progress_mode in
    partclone) [[ $progress_run_id =~ ^[A-Za-z0-9._-]{8,128}$ ]] || exit 0 ;;
    partimage) ;;
    *) exit 0 ;;
esac

prog_stage="running"
case "${type:-}" in
    down|[Dd][Oo][Ww][Nn]) prog_stage=restore ;;
    up|[Uu][Pp]) prog_stage=upload_complete ;;
esac

usleep 3000000
last_pct=0
while :; do
    tmpfile="/tmp/status.pxeos"
    [[ -z $mac ]] && continue
    case $progress_mode in
        partclone)
            IFS= read -r status <"$tmpfile" || status=''
            pct=$(rootpxe_partclone_progress_next_pct "$tmpfile" "$progress_run_id" "$last_pct") || pct=$last_pct
            ;;
        partimage)
            status=$(rootpxe_partimage_progress_status_line "$tmpfile")
            pct=$(rootpxe_partimage_progress_next_pct "$tmpfile" "$last_pct") || pct=$last_pct
            ;;
    esac
    last_pct=$pct
    b64=$(printf '%s' "$status" | base64)
    curl -Lks \
        --data-urlencode "taskid=$taskid" \
        --data-urlencode "token=$task_token" \
        --data-urlencode "mac=$mac" \
        --data-urlencode "sysuuid=$sysuuid" \
        --data-urlencode "progress=$pct" \
        --data-urlencode "stage=$prog_stage" \
        --data-urlencode "message=$b64" \
        "${api_base}progress" >/dev/null 2>&1 || true
    usleep 3000000
done
IFS=$oIFS
