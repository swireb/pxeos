#!/bin/bash
# Direct capture uses only the authenticated connection policy, without a
# shadow tree, target inspection, or per-file storage controller.
if [[ ${rootpxe_capture_direct:-no} == yes ]]; then
    [[ ! -L /storage && ( ! -e /storage || -d /storage ) ]] || handleError "Unsafe capture mount point"
    mkdir -p /storage || handleError "Capture mount point unavailable"
    if mountpoint -q /storage; then umount /storage || handleError "Capture mount point busy"; fi
    case $protocol in
        smb)
            case $rootpxe_capture_smb_version in
                auto) capture_version=default;; 2.1|3.0|3.1.1) capture_version=$rootpxe_capture_smb_version;; 3.0.2) capture_version=3.02;; *) handleError "Invalid capture SMB version";;
            esac
            rootpxe_run_logged_typed_native storage-mount.log storage mount.cifs "//$storage_server/$storage_export" /storage -o "iocharset=utf8,rw,serverino,vers=$capture_version,credentials=$smb_credentials_file"
            capture_mount_status=$?; rootpxe_cleanup_smb_credentials
            ;;
        nfs)
            capture_options=rw,nolock,proto=tcp
            [[ $rootpxe_capture_nfs_version == auto ]] || capture_options+=",vers=$rootpxe_capture_nfs_version"
            rootpxe_run_logged_typed_native storage-mount.log storage mount -t nfs -o "$capture_options" "$storage_server:$storage_export" /storage
            capture_mount_status=$?
            ;;
        *) handleError "Invalid capture storage protocol";;
    esac
    [[ $capture_mount_status == 0 ]] || handleError "Capture storage mount failed"
    return 0
fi
# Managed tasks obtain storage only from authenticated JSON checkin.
[[ -n ${rootpxe_storage_workspace:-} ]] || handleError "PXEOS_STAGE=storage CODE=STORAGE_CONTEXT_REQUIRED"
[[ ! -L /storage && ( ! -e /storage || -d /storage ) ]] || handleError "PXEOS_STAGE=storage CODE=STORAGE_MOUNTPOINT_UNSAFE"
mkdir -p /storage || handleError "PXEOS_STAGE=storage CODE=STORAGE_MOUNTPOINT_UNAVAILABLE"
umount /ntfs /bcdstore >/dev/null 2>&1 || true
if mountpoint -q /storage; then
    umount /storage || handleError "PXEOS_STAGE=storage CODE=STORAGE_PREVIOUS_MOUNT_BUSY"
fi
dots "Mounting file system"
case ${protocol:-} in
    nfs)
        rootpxe_storage_native mount-nfs >/dev/null || handleError "PXEOS_STAGE=storage CODE=STORAGE_NFS_MOUNT_FAILED"
        ;;
    smb)
        [[ -n ${smb_credentials_file:-} ]] && command -v mount.cifs >/dev/null 2>&1 || handleError "PXEOS_STAGE=storage CODE=STORAGE_SMB_CREDENTIALS_REQUIRED"
        resolved=$(rootpxe_storage_native resolve) || handleError "PXEOS_STAGE=storage CODE=STORAGE_SERVER_INVALID"
        mount_server=$(jq -r '.mountServer' <<<"$resolved")
        mount_address=$(jq -r '.numericAddress' <<<"$resolved")
        mount_port=$(jq -r '.port' <<<"$resolved")
        smb_policy=$(jq -r '.smbVersion' "$rootpxe_storage_workspace/context.json")
        case $smb_policy in
            auto) mount_version=default;; 2.1) mount_version=2.1;; 3.0) mount_version=3.0;; 3.0.2) mount_version=3.02;; 3.1.1) mount_version=3.1.1;;
            *) handleError "PXEOS_STAGE=storage CODE=STORAGE_SMB_VERSION_INVALID";;
        esac
        mount_access=ro; [[ ${type:-} != up ]] || mount_access=rw
        rootpxe_storage_mount_smb "//$mount_server/$storage_export" /storage -o "iocharset=utf8,$mount_access,serverino,vers=$mount_version,ip=$mount_address,port=$mount_port,credentials=$smb_credentials_file"
        mount_result=$?; rootpxe_cleanup_smb_credentials
        [[ $mount_result -eq 0 ]] || handleError "PXEOS_STAGE=storage CODE=STORAGE_SMB_MOUNT_FAILED"
        ;;
    *) handleError "PXEOS_STAGE=storage CODE=STORAGE_PROTOCOL_INVALID";;
esac
rootpxe_storage_start || handleError "PXEOS_STAGE=storage CODE=STORAGE_PREFLIGHT_FAILED"
echo "Done"
debugPause
