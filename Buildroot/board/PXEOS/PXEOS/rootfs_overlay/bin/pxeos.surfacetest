#!/bin/bash
. /usr/share/pxeos/lib/funcs.sh || exit 1
clearScreen
displayBanner
dots "Locating disk devices"
disks=""
disk=""
hd=""
getHardDisk "true"
if [[ -z $disks ]]; then
    echo "Failed"
    debugPause
    handleError "No hard disks found! ($0)\n   Args Passed: $*"
fi
echo "Done"
debugPause
for disk in $disks; do
    dots "Disk device surface test for $disk"
    usleep 2000000
    badblocks -sv $disk
rootpxe_console_prompt INFO 'Press Enter to continue.'
    read -r
done
. /bin/pxeos.nonimgcomplete
