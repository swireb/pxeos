#!/bin/bash
#
# Start the network....
#
# S40network runs before funcs.sh is available. Keep its own console formatter
# compatible with the PXEOS runtime helpers.
pxeos_network_message() {
    local level="$1" message="${2-}" line chunk
    case $level in INFO|WARN|ERROR) ;; *) return 1;; esac
    while IFS= read -r line || [[ -n $line ]]; do
        while (( ${#line} > 72 )); do
            chunk=${line:0:72}
            printf '%-7s %s\n' "[$level]" "$chunk"
            line=${line:72}
        done
        printf '%-7s %s\n' "[$level]" "$line"
    done <<<"$message"
}
pxeos_network_prompt() {
    local level="$1" message="${2-}"
    case $level in INFO|WARN|ERROR) ;; *) return 1;; esac
    printf '%-7s %s' "[$level]" "$message"
}
pxeos_network_status_begin() {
    local message="$1" dots padding
    dots=$(printf '%0.1s' .{1..55})
    padding=$((55-${#message}))
    (( padding < 1 )) && padding=1
    printf '%-7s %s%*.*s' '[INFO]' "$message" 0 "$padding" "$dots"
}
pxeos_network_status_finish() {
    printf '%s\n' "$1"
}
pxeos_network_acquire_dhcp() {
    local iface="$1" logfile rc address
    logfile="/tmp/pxeos-dhcp-${iface}.log"
    pxeos_network_status_begin "Acquiring DHCP lease on $iface"
    if /sbin/udhcpc -i "$iface" --now >"$logfile" 2>&1; then
        pxeos_network_status_finish 'Done'
        address=$(/sbin/ip -4 -o addr show dev "$iface" scope global 2>/dev/null | awk 'NR == 1 { print $4 }')
        [[ -n $address ]] && pxeos_network_message INFO "IPv4 address: $address."
        return 0
    else
        rc=$?
    fi
    pxeos_network_status_finish "Failed (exit $rc)"
    pxeos_network_message INFO "Details: $logfile"
    return "$rc"
}
if [[ -n $has_usb_nic ]]; then
    pxeos_network_message INFO "Please unplug and reconnect the USB network device."
    pxeos_network_prompt INFO "Press Enter to connect the USB network device."
    read -r
    pxeos_network_message INFO "Waiting 5s for the USB network device to reconnect."
    sleep 5
fi

# Geo-Grabbing kernel parameters because the variables are probably not set yet
while IFS= read -r var; do
    [[ $var == *=* ]] || continue
    key=${var%%=*}; value=${var#*=}; value=${value//+_+/ }; value=${value//+__+/ }
    case "$key" in mac|web|pxeapi|setmacto|isdebug|has_usb_nic) printf -v "$key" '%s' "$value"; export "$key";; esac
done < <(tr ' ' '\n' </proc/cmdline)

# This is intentionally invoked only after every interface failed DHCP/API
# reachability.  Keep it read-only and never print kernel arguments, API URLs
# or credentials: these diagnostics are commonly photographed or copied from
# an unattended PXE console.
pxeos_network_init_version() {
    local version
    version=$(sed -n 's/^export initversion=\([0-9][0-9]*\)$/\1/p' /usr/share/pxeos/lib/funcs.sh 2>/dev/null | head -n 1)
    printf '%s' "${version:-unavailable}"
}

pxeos_network_diagnostics() {
    local kernel iface
    echo
    pxeos_network_message INFO "PXEOS network diagnostics:"
    kernel=$(uname -r 2>/dev/null) || kernel=unavailable
    pxeos_network_message INFO "Kernel: $kernel"
    pxeos_network_message INFO "PXEOS init version: $(pxeos_network_init_version)"
    pxeos_network_message INFO "Ethernet/network PCI devices:"
    if command -v lspci >/dev/null 2>&1; then
        lspci -nnk 2>/dev/null | grep -Ei 'ethernet|network' || pxeos_network_message INFO 'No PCI network device reported.'
    else
        pxeos_network_message WARN 'lspci is not installed.'
    fi
    pxeos_network_message INFO "Interfaces:"
    if /sbin/ip -br link 2>/dev/null; then
        /sbin/ip -br addr 2>/dev/null || true
    else
        for iface in /sys/class/net/*; do
            [[ -e $iface ]] || continue
            printf '  %s\n' "${iface##*/}"
        done
    fi
}

# Enable loopback interface
echo -e "auto lo\niface lo inet loopback\n\n" > /etc/network/interfaces
/sbin/ip addr add 127.0.0.1/8 dev lo
/sbin/ip link set lo up

sleep 10

# Generated a sorted list with primary interfaces first
read p_ifaces <<< $(/sbin/ip -0 addr show | awk 'ORS=NR%2?FS:RS' | awk -F'[: ]+' 'tolower($0) ~ /link[/]?ether/ && tolower($0) ~ /'$mac'/ {print $2}' | tr '\n' ' ')
read o_ifaces <<< $(/sbin/ip -0 addr show | awk 'ORS=NR%2?FS:RS' | awk -F'[: ]+' 'tolower($0) ~ /link[/]?ether/ && tolower($0) !~ /'$mac'/ {print $2}' | tr '\n' ' ')
ifaces="$p_ifaces $o_ifaces"
for iface in $ifaces; do
    pxeos_network_status_begin "Starting interface $iface and waiting for link"
    echo -e "auto $iface\niface $iface inet dhcp\n\n" >> /etc/network/interfaces
    /sbin/ip link set $iface up

    # Wait till the interface is fully up and ready (spanning tree)
    timeout=0
    linkstate=0
    until [[ $linkstate -eq 1 || $timeout -ge 35 ]]; do
        let timeout+=1
        linkstate=$(/bin/cat /sys/class/net/$iface/carrier)
        [[ $linkstate -eq 0 ]] && sleep 1 || break
    done
    if [[ $linkstate -eq 0 ]]; then
        pxeos_network_status_finish 'Failed (no link)'
        pxeos_network_message WARN "No link on $iface after ${timeout}s; skipping."
        continue
    fi
    pxeos_network_status_finish 'Done'
    for retry in $(seq 3); do
        pxeos_network_acquire_dhcp "$iface"
        ustat="$?"
        # RootPXE/PXEOS 连通性统一探测 /health（不再兼容 index.php）
        cstat=1
        if [[ -n $pxeapi ]]; then
            curl -Ikfso /dev/null "${pxeapi}health" --connect-timeout 5
            cstat="$?"
        elif [[ -n $web ]]; then
            curl -Ikfso /dev/null "${web}health" --connect-timeout 5
            cstat="$?"
        fi
        # If the udhcp is okay AND we can curl our web
        # we know we have link so no need to continue on.
        # NOTE: the link to web is kind of important, just
        # exiting on dhcp request is not sufficient.
        if [[ $ustat -eq 0 && $cstat -eq 0 ]]; then
            mac_curr=$(ip link show $iface | awk '/ether/ {print tolower($2)}')
            if [[ ! -z $setmacto ]]; then
                mac_sett=$(echo "$setmacto" | awk '{print tolower($1)}')
                if [[ "x$mac_curr" != "x$mac_sett" ]]; then
                    ip link set dev $iface down
                    ip link set dev $iface address $mac_sett
                    ip link set dev $iface up
                    pxeos_network_acquire_dhcp "$iface"
                    ustat="$?"
                    cstat=1
                    if [[ -n $pxeapi ]]; then
                        curl -Ikfso /dev/null "${pxeapi}health" --connect-timeout 5
                        cstat="$?"
                    elif [[ -n $web ]]; then
                        curl -Ikfso /dev/null "${web}health" --connect-timeout 5
                        cstat="$?"
                    fi
                    [[ $ustat -eq 0 && $cstat -eq 0 ]] && exit 0
                fi
            fi
            [[ $ustat -eq 0 && $cstat -eq 0 ]] && exit 0
        fi
        pxeos_network_message WARN "DHCP or PXEOS API connectivity check failed."
        # Geo-If we are on the 2nd loop, lets check to see if
        # spanning tree is blocking dhcp
        if [[ $seq -eq 2 ]]; then
            pxeos_network_message INFO "Waiting for spanning-tree timeout on $iface."
            sleep 27
        else
            sleep 1
        fi
    done
    pxeos_network_message WARN "No DHCP response on $iface; skipping."
done

# If we end up here something went wrong as we do exit the script as soon as we get an IP!
if [[ -z "$(echo $ifaces | tr -d ' ')" ]]; then  # because ifaces is constructed with a space, we must strip it
    pxeos_network_message ERROR "No network interface found. The kernel may lack a driver."
else
    pxeos_network_message ERROR "DHCP did not assign an IP address. Interfaces: $ifaces"
fi
pxeos_network_diagnostics
pxeos_network_message INFO "Check the network setup and try again."
[[ -z $isdebug ]] && sleep 60 && reboot
pxeos_network_prompt INFO "Press Enter to continue."
read -r -t 60
exit 1
