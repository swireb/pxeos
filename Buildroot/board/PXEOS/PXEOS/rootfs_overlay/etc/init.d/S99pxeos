#!/bin/bash
#
#
# rc.single     This file is executed by init when it goes into runlevel
#               1, which is the administrative state. It kills all
#               deamons and then puts the system into single user mode.
#               Note that the file systems are kept mounted.
#
# Author:       Miquel van Smoorenburg, <miquels@drinkel.nl.mugnet.org>
#               Modified for RHS Linux by Damien Neil
#               Modified for FOG by Chuck Syperski
#
[[ ! -h /dev/fd ]] && ln -s /proc/self/fd /dev/fd
[[ ! -h /dev/stdin ]] && ln -s /proc/self/fd/0 /dev/stdin
[[ ! -h /dev/stdout ]] && ln -s /proc/self/fd/1 /dev/stdout
[[ ! -h /dev/stderr ]] && ln -s /proc/self/fd/2 /dev/stderr

pxeos_init_message() {
    local level="$1" message="${2-}"
    case $level in
        INFO|WARN|ERROR) ;;
        *) return 1 ;;
    esac
    printf '%-7s %s\n' "[$level]" "$message"
}

pxeos_manual_task_handoff() {
    local handoff_dir handoff_file
    local -a fields
    handoff_dir=/tmp/pxeos-manual-task
    handoff_file="$handoff_dir/context"
    [[ -d $handoff_dir && ! -L $handoff_dir && -f $handoff_file && ! -L $handoff_file ]] || return 1
    mapfile -t fields <"$handoff_file" || return 1
    rm -f -- "$handoff_file"; rmdir "$handoff_dir" 2>/dev/null || true
    [[ ${#fields[@]} -eq 6 ]] || return 1
    taskid=${fields[0]}; task_token=${fields[1]}; mac=${fields[2]}; manual_task_type=${fields[3]}; mdraid=${fields[4]}; manual_spki_pin=${fields[5]}
    [[ $taskid =~ ^[1-9][0-9]*$ && $task_token =~ ^[A-Za-z0-9._~+/=-]+$ && ${#task_token} -ge 16 && ${#task_token} -le 512 ]] || return 1
    [[ $mac =~ ^[0-9a-f]{2}(:[0-9a-f]{2}){5}$ ]] || return 1
    [[ $manual_spki_pin =~ ^sha256//[A-Za-z0-9+/]{43}=$ ]] || return 1
    case $manual_task_type in deploy) type=down;; capture) type=up;; *) return 1;; esac
    case $mdraid in true|'') ;; *) return 1;; esac
    mode=''
    manual_direct_task=yes
    export taskid task_token mac type mdraid manual_spki_pin manual_direct_task mode
}

# SSH 调试模式只保留网络初始化后的登录入口，不能触发 RAID 组装、任务或电源操作。
case $isdebug in
    [Yy][Ee][Ss]|[Yy])
        pxeos.debug
        exit $?
        ;;
esac

# Manual registration is an interactive control-plane session, not a task.
# It must run before RAID discovery and must never fall through to the normal
# task failure/reboot policy when networking, authentication, or the console
# interaction fails.
if [[ $mode == manreg ]]; then
    pxeos.man.reg
    rc=$?
    if [[ $rc -eq 20 ]]; then
        if ! pxeos_manual_task_handoff; then
            pxeos_init_message ERROR 'Manual task handoff is invalid. No task was started.'
            exit 1
        fi
    else
        if [[ $rc -ne 0 ]]; then
        pxeos_init_message WARN 'Manual registration ended without reboot. Use firmware local boot if the service is unavailable.'
        fi
        exit "$rc"
    fi
fi

if [[ $mdraid == true ]]; then
    mdadm --auto-detect
    mdadm --assemble --scan
    mdadm --incremental --run --scan
fi
[[ -n $keymap ]] && loadkeys $keymap

pxeos
rc=$?
if [[ $rc -eq 0 ]]; then
    sleep 5 >/dev/null 2>&1
    # 优先读取 checkin 下发并落盘的 shutdown（0/1）
    shutdown_local="$shutdown"
    if [[ -f /tmp/pxeos.shutdown ]]; then
        shutdown_local="$(tr -d '\r\n\0' </tmp/pxeos.shutdown)"
    fi
    if [[ "$shutdown_local" == "1" ]]; then
        pxeos_init_message INFO 'Task completed. Powering off.'
        poweroff >/dev/null 2>&1
    else
        pxeos_init_message INFO 'Task completed. Rebooting.'
        reboot -f >/dev/null 2>&1
    fi
else
    pxeos_init_message WARN "Task exited with code: $rc."
    failure_action="reboot"
    [[ -f /tmp/pxeos.failure_action ]] && failure_action="$(tr -d '\r\n\0' </tmp/pxeos.failure_action)"
    pxeos_init_message INFO "Running configured failure action: $failure_action."
    if [[ "$failure_action" == "shutdown" ]]; then
        poweroff >/dev/null 2>&1
    else
        reboot -f >/dev/null 2>&1
    fi
fi
