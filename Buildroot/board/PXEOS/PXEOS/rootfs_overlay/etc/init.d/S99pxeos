#!/bin/bash
#
#
# rc.single     This file is executed by init when it goes into runlevel
#               1, which is the administrative state. It kills all
#               deamons and then puts the system into single user mode.
#               Note that the file systems are kept mounted.
#
# Author:       Miquel van Smoorenburg, <miquels@drinkel.nl.mugnet.org>
#               Modified for RHS Linux by Damien Neil
#               Modified for FOG by Chuck Syperski
#
[[ ! -h /dev/fd ]] && ln -s /proc/self/fd /dev/fd
[[ ! -h /dev/stdin ]] && ln -s /proc/self/fd/0 /dev/stdin
[[ ! -h /dev/stdout ]] && ln -s /proc/self/fd/1 /dev/stdout
[[ ! -h /dev/stderr ]] && ln -s /proc/self/fd/2 /dev/stderr

pxeos_init_message() {
    local level="$1" message="${2-}"
    case $level in
        INFO|WARN|ERROR) ;;
        *) return 1 ;;
    esac
    printf '%-7s %s\n' "[$level]" "$message"
}

pxeos_quiet_shutdown_marker='/.pxeos-quiet-shutdown'
pxeos_quiet_shutdown_console_loglevel=''
pxeos_quiet_shutdown_marker_created=0
pxeos_quiet_shutdown_console_changed=0

pxeos_remove_quiet_shutdown_marker() {
    local marker="$pxeos_quiet_shutdown_marker"

    if [[ $pxeos_quiet_shutdown_marker_created -eq 1 && -f $marker && ! -L $marker && -O $marker ]]; then
        rm -f -- "$marker"
    fi
    pxeos_quiet_shutdown_marker_created=0
}

pxeos_enable_quiet_shutdown() {
    local marker="$pxeos_quiet_shutdown_marker"

    pxeos_quiet_shutdown_marker_created=0
    pxeos_quiet_shutdown_console_loglevel=''
    pxeos_quiet_shutdown_console_changed=0
    if [[ -e $marker || -L $marker ]]; then
        pxeos_init_message WARN 'Quiet shutdown marker already exists. Leaving normal shutdown messages enabled.'
        return 1
    fi
    if ! (umask 077; set -C; : >"$marker") 2>/dev/null; then
        pxeos_init_message WARN 'Could not create quiet shutdown marker. Leaving normal shutdown messages enabled.'
        return 1
    fi
    pxeos_quiet_shutdown_marker_created=1
    if [[ ! -f $marker || -L $marker || ! -O $marker ]] || ! chmod 600 -- "$marker" 2>/dev/null; then
        pxeos_remove_quiet_shutdown_marker
        pxeos_init_message WARN 'Quiet shutdown marker is invalid. Leaving normal shutdown messages enabled.'
        return 1
    fi
    if ! read -r pxeos_quiet_shutdown_console_loglevel _ </proc/sys/kernel/printk \
        || [[ ! $pxeos_quiet_shutdown_console_loglevel =~ ^([0-9]|1[0-5])$ ]]; then
        pxeos_remove_quiet_shutdown_marker
        pxeos_init_message WARN 'Could not read kernel console log level. Leaving normal shutdown messages enabled.'
        return 1
    fi
    if ! printf '0\n' >/proc/sys/kernel/printk; then
        pxeos_remove_quiet_shutdown_marker
        pxeos_init_message WARN 'Could not lower kernel console log level for shutdown. Leaving normal shutdown messages enabled.'
        return 1
    fi
    pxeos_quiet_shutdown_console_changed=1
}

pxeos_restore_quiet_shutdown() {
    local action="$1" action_rc="$2"

    if [[ $pxeos_quiet_shutdown_console_changed -eq 1 ]] \
        && ! printf '%s\n' "$pxeos_quiet_shutdown_console_loglevel" >/proc/sys/kernel/printk; then
        pxeos_init_message WARN 'Could not restore kernel console log level after power action failure.'
    fi
    pxeos_quiet_shutdown_console_changed=0
    pxeos_remove_quiet_shutdown_marker
    pxeos_init_message ERROR "$action command failed with code: $action_rc. Quiet shutdown was disabled."
}

pxeos_manual_task_handoff() {
    local handoff_dir handoff_file
    local -a fields
    handoff_dir=/tmp/pxeos-manual-task
    handoff_file="$handoff_dir/context"
    [[ -d $handoff_dir && ! -L $handoff_dir && -f $handoff_file && ! -L $handoff_file ]] || return 1
    mapfile -t fields <"$handoff_file" || return 1
    rm -f -- "$handoff_file"; rmdir "$handoff_dir" 2>/dev/null || true
    [[ ${#fields[@]} -eq 6 ]] || return 1
    taskid=${fields[0]}; task_token=${fields[1]}; mac=${fields[2]}; manual_task_type=${fields[3]}; mdraid=${fields[4]}; manual_spki_pin=${fields[5]}
    [[ $taskid =~ ^[1-9][0-9]*$ && $task_token =~ ^[A-Za-z0-9._~+/=-]+$ && ${#task_token} -ge 16 && ${#task_token} -le 512 ]] || return 1
    [[ $mac =~ ^[0-9a-f]{2}(:[0-9a-f]{2}){5}$ ]] || return 1
    [[ $manual_spki_pin =~ ^sha256//[A-Za-z0-9+/]{43}=$ ]] || return 1
    case $manual_task_type in deploy) type=down;; capture) type=up;; *) return 1;; esac
    case $mdraid in true|'') ;; *) return 1;; esac
    mode=''
    manual_direct_task=yes
    export taskid task_token mac type mdraid manual_spki_pin manual_direct_task mode
}

pxeos_apply_storage_failure_action() {
    case ${1:-} in
        reboot) pxeos_init_message INFO 'Running configured failure action: reboot.'; reboot -f >/dev/null 2>&1 ;;
        shutdown) pxeos_init_message INFO 'Running configured failure action: shutdown.'; poweroff >/dev/null 2>&1 ;;
    esac
}

pxeos_wait_storage_failure() (
    local diagnostic="$1" failed_at="$2" api response policy wait_seconds action remaining http_status state
    local rootpxe_failure_deadline
    local handoff_id=${taskid:-} handoff_token=${task_token:-} handoff_mac=${mac:-}
    local handoff_type=${type:-} handoff_pin=${manual_spki_pin:-} manual_direct=${manual_direct_task:-}
    local -a tls=(-k)
    . /usr/share/pxeos/lib/funcs.sh || return 1
    api=${pxeapi:-${web:-}}
    if [[ $manual_direct == yes ]]; then
        taskid=$handoff_id; task_token=$handoff_token; mac=$handoff_mac; type=$handoff_type
        [[ $api == https://* && $handoff_pin =~ ^sha256//[A-Za-z0-9+/]{43}=$ ]] || return 1
        tls+=(--proto '=https' --proto-redir '=https' --pinnedpubkey "$handoff_pin")
    elif [[ -n ${mode:-} && ${mode:-} != deploy && ${mode:-} != capture ]]; then
        return 0
    fi
    case ${type:-} in down|up) ;; *) return 0 ;; esac
    [[ -n $api ]] && rootpxe_require_task_context || return 0
    [[ $failed_at =~ ^[1-9][0-9]*$ ]] || return 1
    diagnostic=$(rootpxe_bound_callback_message "$diagnostic") || return 1
    response=$(rootpxe_task_curl "${tls[@]}" --fail --silent --connect-timeout 2 --max-time 5 \
        --data-urlencode "taskid=$taskid" --data-urlencode "token=$task_token" --data-urlencode "mac=$mac" \
        --data-urlencode stage=storage_probe --data-urlencode errorCode=STORAGE_PROBE_FAILED \
        --data-urlencode "message=$diagnostic" -w '\n%{http_code}' "${api%/}/error") || return 1
    http_status=${response##*$'\n'}
    [[ $http_status =~ ^2[0-9][0-9]$ ]] || return 1
    policy=$(jq -ers '
        select(length == 1) | .[0]
        | select(.accepted == true and .status == "failed")
        | select((.waitSec | type) == "number" and (.waitSec | floor) == .waitSec and .waitSec >= 60 and .waitSec <= 3600)
        | select(.failureAction == "reboot" or .failureAction == "shutdown")
        | [.waitSec, .failureAction] | @tsv
    ' <<<"${response%$'\n'*}") || return 1
    IFS=$'\t' read -r wait_seconds action <<<"$policy" || return 1
    rootpxe_failure_deadline=$((failed_at + wait_seconds))
    rootpxe_console_message WARN 'Task failed. The configured failure wait has started.' >&2
    rootpxe_console_message INFO "Failure wait: ${wait_seconds}s from first failure. Timeout action: $action." >&2
    rootpxe_console_message INFO 'SSH is available for troubleshooting.' >&2

    local -a status_args=(--data-urlencode "taskid=$taskid" --data-urlencode "token=$task_token" --data-urlencode "mac=$mac")
    while :; do
        remaining=$(rootpxe_failure_remaining) || remaining=0
        response=$(rootpxe_task_curl "${tls[@]}" --silent --connect-timeout 2 --max-time 5 \
            "${status_args[@]}" -w '\n%{http_code}' "${api%/}/task-status") || response=''
        http_status=${response##*$'\n'}
        case $http_status in
            200)
                state=$(jq -ers 'select(length == 1) | .[0].status | strings' <<<"${response%$'\n'*}") || state=''
                if [[ -n $state && $state != failed ]]; then
                    rootpxe_console_message INFO 'The failed task changed. Its timeout action was cancelled.' >&2
                    return 0
                fi
                if [[ $state == failed && $remaining == 0 ]]; then
                    printf '%s\n' "$action"
                    return
                fi
                ;;
            400|401|403|404|409)
                rootpxe_console_message INFO 'The failed task is no longer authorized. Its timeout action was cancelled.' >&2
                return 0
                ;;
        esac
        # Only a status query made at or after the deadline may authorize the action.
        (( remaining > 0 )) || return 1
        if remaining=$(rootpxe_failure_remaining); then
            sleep "$(( remaining < 5 ? remaining : 5 ))"
        fi
    done
)

# SSH 调试模式只保留网络初始化后的登录入口，不能触发 RAID 组装、任务或电源操作。
case $isdebug in
    [Yy][Ee][Ss]|[Yy])
        pxeos.debug
        exit $?
        ;;
esac

# Manual registration is an interactive control-plane session, not a task.
# It must run before RAID discovery and must never fall through to the normal
# task failure/reboot policy when networking, authentication, or the console
# interaction fails.
if [[ $mode == manreg ]]; then
    pxeos.man.reg
    rc=$?
    if [[ $rc -eq 20 ]]; then
        if ! pxeos_manual_task_handoff; then
            pxeos_init_message ERROR 'Manual task handoff is invalid. No task was started.'
            exit 1
        fi
    else
        if [[ $rc -ne 0 ]]; then
        pxeos_init_message WARN 'Manual registration ended without reboot. Use firmware local boot if the service is unavailable.'
        fi
        exit "$rc"
    fi
fi

if ! storage_probe_diagnostic=$(pxeos-storage-probe wait 2>&1); then
    storage_probe_failed_at=$(date +%s)
    storage_probe_diagnostic=${storage_probe_diagnostic:-Storage probe failed.}
    pxeos_init_message ERROR "$storage_probe_diagnostic"
    if storage_failure_action=$(pxeos_wait_storage_failure "$storage_probe_diagnostic" "$storage_probe_failed_at"); then
        pxeos_apply_storage_failure_action "$storage_failure_action"
    else
        pxeos_init_message WARN 'RootPXE did not confirm the storage failure or its timeout action.'
    fi
    pxeos_init_message ERROR 'Storage probe incomplete. PXEOS remains available.'
    exit 75
fi

if [[ $mdraid == true ]]; then
    mdadm --auto-detect
    mdadm --assemble --scan
    mdadm --incremental --run --scan
fi
[[ -n $keymap ]] && loadkeys $keymap

pxeos
rc=$?
if [[ $rc -eq 75 || ( $rc -ne 0 && $type == down ) ]]; then
    pxeos_init_message INFO 'Deployment stopped. PXEOS remains available.'
    exit "$rc"
fi
if [[ $rc -eq 0 && -f /tmp/pxeos.storage-recovery-only && ! -L /tmp/pxeos.storage-recovery-only && -O /tmp/pxeos.storage-recovery-only ]]; then
    pxeos_init_message INFO "Storage recovery ended with code: $rc. No disk or power action will be repeated."
    exit "$rc"
fi
if [[ $rc -eq 0 ]]; then
    # 优先读取 checkin 下发并落盘的 shutdown（0/1）
    shutdown_local="$shutdown"
    if [[ -f /tmp/pxeos.shutdown ]]; then
        shutdown_local="$(tr -d '\r\n\0' </tmp/pxeos.shutdown)"
    fi
    if [[ "$shutdown_local" == "1" ]]; then
        pxeos_init_message INFO 'Task completed. Powering off in 5s.'
    else
        pxeos_init_message INFO 'Task completed. Rebooting in 5s.'
    fi
    sleep 5 >/dev/null 2>&1
    pxeos_enable_quiet_shutdown || true
    if [[ "$shutdown_local" == "1" ]]; then
        poweroff >/dev/null 2>&1 || { power_rc=$?; pxeos_restore_quiet_shutdown poweroff "$power_rc"; exit "$power_rc"; }
    else
        reboot -f >/dev/null 2>&1 || { reboot_rc=$?; pxeos_restore_quiet_shutdown reboot "$reboot_rc"; exit "$reboot_rc"; }
    fi
else
    pxeos_init_message WARN "Task exited with code: $rc."
    failure_action="reboot"
    [[ -f /tmp/pxeos.failure_action ]] && failure_action="$(tr -d '\r\n\0' </tmp/pxeos.failure_action)"
    pxeos_init_message INFO "Running configured failure action: $failure_action."
    if [[ "$failure_action" == "shutdown" ]]; then
        poweroff >/dev/null 2>&1
    else
        reboot -f >/dev/null 2>&1
    fi
fi
