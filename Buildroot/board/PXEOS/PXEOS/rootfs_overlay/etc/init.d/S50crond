#!/bin/bash
. /usr/share/pxeos/lib/log-paths.sh

DAEMON="crond"
PIDFILE="/var/run/$DAEMON.pid"
CROND_ARGS=""
LOGFILE="/tmp/log/cron.log"

# shellcheck source=/dev/null
[[ -r "/etc/default/$DAEMON" ]] && . "/etc/default/$DAEMON"

pxeos_service_message() {
    local level="$1" message="${2-}" line chunk
    case $level in INFO|WARN|ERROR) ;; *) return 1 ;; esac
    while IFS= read -r line || [[ -n $line ]]; do
        while (( ${#line} > 72 )); do
            chunk=${line:0:72}
            printf '%-7s %s\n' "[$level]" "$chunk"
            line=${line:72}
        done
        printf '%-7s %s\n' "[$level]" "$line"
    done <<<"$message"
}
pxeos_service_status_begin() {
    local message="$1" dots padding
    dots=$(printf '%0.1s' .{1..55})
    padding=$((55-${#message}))
    (( padding < 1 )) && padding=1
    printf '%-7s %s%*.*s' '[INFO]' "$message" 0 "$padding" "$dots"
}
pxeos_service_status_finish() {
    printf '%s\n' "$1"
}

start() {
    local status
    pxeos_service_status_begin 'Starting cron service'
    # The daemon's own output is retained for SSH troubleshooting instead of
    # being interleaved with PXEOS status rows on the console.
    # shellcheck disable=SC2086 # CROND_ARGS intentionally supports word splitting.
    if rootpxe_log_boot_run cron.log start background start-stop-daemon --start --background --make-pidfile \
        --pidfile "$PIDFILE" --exec "/usr/sbin/$DAEMON" \
        -- -f $CROND_ARGS; then
        pxeos_service_status_finish 'Done'
        return 0
    else
        status=$?
    fi
    pxeos_service_status_finish "Failed (exit $status)"
    rootpxe_log_notice cron.log
    return "$status"
}

stop() {
    local status
    pxeos_service_status_begin 'Stopping cron service'
    rootpxe_log_boot_run cron.log stop foreground start-stop-daemon --stop --pidfile "$PIDFILE" --exec "/usr/sbin/$DAEMON"
    status=$?
    while start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" \
        --exec "/usr/sbin/$DAEMON" >/dev/null 2>&1; do
        sleep 0.1
    done
    rm -f "$PIDFILE"
    if [[ $status -eq 0 ]]; then
        pxeos_service_status_finish 'Done'
        return 0
    fi
    pxeos_service_status_finish "Failed (exit $status)"
    rootpxe_log_notice cron.log
    return "$status"
}

restart() {
    stop
    start
}

case "$1" in
    start|stop|restart) "$1" ;;
    reload) restart ;;
    *)
        pxeos_service_message ERROR "Usage: $0 {start|stop|restart|reload}"
        exit 1
        ;;
esac
